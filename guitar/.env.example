# Copy to .env (gitignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# later, for GPT-6 Astra:
OPENAI_API_KEY=

# Baseten-hosted model brain (agent loop backend: --backend baseten).
BASETEN_API_KEY=
# If your repo-root .env already uses BASETEN=..., that alias is also accepted.
BASETEN_MODEL_ID=
BASETEN_ENV=development
# Optional full endpoint override, e.g. https://model-<id>.api.baseten.co/development/predict
# BASETEN_MODEL_URL=
