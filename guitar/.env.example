# Copy to .env (gitignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# later, for GPT-6 Astra:
OPENAI_API_KEY=

# Active planner: Kimi K3, already hosted on Baseten Model APIs.
# The repo-root .env is also supported; BASETEN is accepted as a key alias.
BASETEN_API_KEY=
BASETEN_MODEL=moonshotai/Kimi-K3
BASETEN_REASONING_EFFORT=high
BASETEN_MAX_TOKENS=8192
BASETEN_TIMEOUT_S=180

# Separate, opt-in audio evaluator. Does not change the planner or start capture.
# Currently blocked by provider timeouts; use evaluate_audio.py --inspect offline.
BASETEN_AUDIO_MODEL=thinkingmachines/inkling
BASETEN_AUDIO_TIMEOUT_S=30

# No BASETEN_MODEL_ID, BASETEN_MODEL_URL, or BASETEN_ENV is needed for Model APIs.
# Those settings belong only to the inactive --backend baseten-custom Truss path.
