@@ -0,0 +1,18 @@
+export interface DanceSong {
+  id: string; title: string; artist: string; genre: string; bpm: number; meter: number;
+  mood: string; color: string; source: string;
+  youtube_id?: string;
+}
+export interface DanceCue {
+  name: string; role: string; start: number; end: number; action_start: number; action_end: number;
+  speed: number; max_speed: number; beats: number; source_window: number[];
+}
+export interface DanceReport {
+  song: DanceSong; bpm: number; meter: number; duration: number; beats: number[]; beat_source: string;
+  variation: number; cues: DanceCue[]; peak_speed: number; speed_budget: number; motor_velocity_limit: number;
+  frames: number; neutral_hold_seconds: number; preview: Array<{ t: number; positions: Record<string, number> }>;
+}
+export interface PreparedDance { id: string; expires_in: number; report: DanceReport }
+export interface DanceStatus { version: number; server_time: number; id?: string | null; song_id?: string | null; state?: string | null; start_at?: number | null; ended_at?: number | null; error?: string | null; audio_ready?: boolean; audio_mode?: string; safety_latched?: boolean; media_time?: number | null }
+export interface DanceCatalog { version: number; songs: DanceSong[]; neutral_valid: boolean; error?: string; safety_latched?: boolean;
+  actions: Array<{ name: string; role: string; max_speed: number; window: number[] }>; }
