+def test_return_collision_rejects_whole_sequence_before_any_movement(tmp_path):
+    def collision(plan):
+        if plan.metadata.get('source') == 'teaching_sequence':
+            assert plan.waypoints[-1].positions == dict.fromkeys(JOINTS, 3.0)
+            raise ValueError('return collision')
+        return plan
+
+    controller, submitted, _, _ = teaching_controller(tmp_path, collision=collision)
+    with pytest.raises(ValueError, match='return collision'):
+        asyncio.run(controller.play_animation('teach_nod_t01'))
+    assert submitted == []
