+"""Dance compilation and admission tests; fake motors only."""
+import asyncio
+import math
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from core.domain.motion import MotionPlan, Waypoint
+from modules.robot_base.control.dance import SONGS, beat_grid, compile_dance, peak_speed, phrase_from_take, retime
+
+INFO = {"joints": {"joint": {"range_min": -100, "range_max": 100}}, "max_velocity_units_s": 100}
+NEUTRAL = {"positions": {"joint": 0.0}}
+
+
+def actions():
+    result = []
+    for index, role in enumerate(('bounce', 'nod', 'sway', 'look_left', 'look_right', 'bow')):
+        plan = MotionPlan(waypoints=[Waypoint(positions={"joint": (5 + index) * math.sin(i / 60 * 2 * math.pi)}, timestamp_ms=i * 50)
+                                     for i in range(61)], duration_ms=3000)
+        result.append({"name": f"teach_{role}_t01", "role": role, "plan": plan, "max_speed": 2.0,
+                       "window": (0, 3), "sha256": str(index)})
+    return result
+
+
+@pytest.mark.parametrize('bpm', [50, 100, 148, 200])
+@pytest.mark.parametrize('song', SONGS, ids=lambda s: s['id'])
+def test_every_song_is_30_seconds_bounded_varied_and_beat_aligned(song, bpm):
+    plan, report = compile_dance(song['id'], actions(), NEUTRAL, INFO, bpm=bpm)
+    assert plan.duration_ms == pytest.approx(30000)
+    assert plan.waypoints[0].positions == plan.waypoints[-1].positions == NEUTRAL['positions']
+    assert peak_speed(plan) <= 65 + 1e-6
+    assert len({cue['name'] for cue in report['cues']}) >= 2
+    for cue in report['cues']:
+        assert cue['speed'] <= cue['max_speed']
+        for field in ('start', 'end', 'action_start', 'action_end'):
+            assert min(abs(cue[field] - t) for t in report['beats']) < 1e-6
+        assert cue['beats'] % song['meter'] == 0
+    assert all(b.timestamp_ms > a.timestamp_ms for a, b in zip(plan.waypoints, plan.waypoints[1:]))
+
+
+def test_five_profiles_have_different_order_and_reshuffle_changes_takes():
+    signatures = set()
+    for song in SONGS:
+        _, report = compile_dance(song['id'], actions(), NEUTRAL, INFO)
+        signatures.add(tuple(c['name'] for c in report['cues']))
+    assert len(signatures) == 5
+    a = compile_dance('waterloo', actions(), NEUTRAL, INFO, variation=0)[1]
+    b = compile_dance('waterloo', actions(), NEUTRAL, INFO, variation=1)[1]
+    assert a['cues'] != b['cues']
+
+
+def test_speed_cap_slows_a_fast_recording_without_changing_positions():
+    raw = MotionPlan(waypoints=[Waypoint(positions={'joint': 0}, timestamp_ms=0),
+                               Waypoint(positions={'joint': 30}, timestamp_ms=100)], duration_ms=100)
+    with pytest.raises(ValueError, match='safe speed'):
+        retime(raw, .1, INFO)
+    safe, speed = retime(raw, 1, INFO)
+    assert speed == .1 and peak_speed(safe) <= 65
+    assert safe.waypoints[-1].positions == raw.waypoints[-1].positions
+    assert raw.duration_ms == 100
+
+
+def test_phrase_window_is_a_contiguous_unmodified_slice():
+    raw = actions()[0]['plan']
+    phrase, (start, end) = phrase_from_take(raw, 1)
+    assert 0 <= start < end <= 3
+    original = [f.positions for f in raw.waypoints if start * 1000 - 1e-5 <= f.timestamp_ms <= end * 1000 + 1e-5]
+    assert [f.positions for f in phrase.waypoints] == original
+
+
+@pytest.mark.parametrize('value', [0, 49, 201, True, float('nan'), float('inf')])
+def test_bad_tempos_fail_closed(value):
+    with pytest.raises((ValueError, TypeError)):
+        beat_grid(value)
+
+
+def test_variable_tempo_grid_and_bad_grids():
+    beats = [0.0]
+    while beats[-1] + .51 < 30:
+        beats.append(beats[-1] + .5 + .01 * math.sin(len(beats)))
+    plan, report = compile_dance('waterloo', actions(), NEUTRAL, INFO, bpm=120, beats=beats)
+    assert plan.duration_ms == pytest.approx(30000)
+    assert report['beats'] == beats and report['beat_source'] == 'analyzed_audio'
+    for invalid in ([0, 0] * 30, [float('nan')] * 60, [0, 2] * 30, list(range(200))):
+        with pytest.raises(ValueError):
+            beat_grid(120, invalid)
+
+
+def test_complete_collision_failure_cannot_return_a_plan():
+    def check(plan):
+        if plan.metadata.get('source') == 'taught_dance':
+            raise ValueError('blocked return path')
+    with pytest.raises(ValueError, match='blocked return path'):
+        compile_dance('waterloo', actions(), NEUTRAL, INFO, collision_check=check)
+
+
+def runtime_fixture(tmp_path):
+    from tests.unit.test_teaching import teaching_controller
+    controller, submitted, measured, neutral = teaching_controller(tmp_path)
+    controller._executor.stop = AsyncMock()
+    target = controller.teaching_neutral()
+    run = {'id': 'dance_test', 'song_id': 'waterloo', 'heartbeat': time.monotonic(), 'cancelled': False, 'error': None, 'audio_ready': True}
+    plan = MotionPlan(waypoints=[Waypoint(positions=neutral, timestamp_ms=0), Waypoint(positions=neutral, timestamp_ms=30000)], duration_ms=30000)
+    record = {'plan': plan, 'neutral': target, 'info': controller.safe_motion_info(), 'report': {'cues': []},
+              'expires': time.monotonic() + 180, 'run': run}
+    controller._dance_prepared['dance_test'] = record
+    return controller, submitted, run, record
+
+
+def test_runtime_enters_neutral_before_countdown_and_finishes_there(tmp_path, monkeypatch):
+    import modules.robot_base.control.dance_runtime as module
+    monkeypatch.setattr(module, 'COUNTDOWN_SECONDS', 0)
+    controller, submitted, run, record = runtime_fixture(tmp_path)
+    asyncio.run(controller.play_animation('dance_test'))
+    assert len(submitted) == 2
+    assert submitted[0].waypoints[-1].positions == record['neutral']['positions']
+    assert run['state'] == 'completed' and run['start_at'] <= time.time()
+    assert run['ended_at'] >= run['start_at']
+    assert 'dance_test' not in controller._dance_prepared
+
+
+def test_stop_after_neutral_never_starts_dance(tmp_path):
+    controller, submitted, run, _ = runtime_fixture(tmp_path)
+    original = controller._executor.execute
+    async def execute(plan):
+        await original(plan)
+        controller._foreground_generation += 1
+    controller._executor.execute = execute
+    with pytest.raises(asyncio.CancelledError):
+        asyncio.run(controller.play_animation('dance_test'))
+    assert len(submitted) == 1 and not run.get('start_at')
+
+
+def test_connection_loss_stops_executor_without_return_movement(tmp_path, monkeypatch):
+    import modules.robot_base.control.dance_runtime as module
+    monkeypatch.setattr(module, 'COUNTDOWN_SECONDS', 0)
+    monkeypatch.setattr(module, 'LEASE_SECONDS', .12)
+    controller, submitted, run, _ = runtime_fixture(tmp_path)
+    original = controller._executor.execute
+    async def execute(plan):
+        await original(plan)
+        if len(submitted) == 2:
+            await asyncio.sleep(.25)
+    controller._executor.execute = execute
+    with pytest.raises(asyncio.CancelledError):
+        asyncio.run(controller.play_animation('dance_test'))
+    assert len(submitted) == 2
+    assert 'connection lost' in run['error']
+    controller._executor.stop.assert_awaited_once()
+
+
+def test_changed_neutral_and_expired_preview_reject_before_motion(tmp_path):
+    controller, submitted, run, record = runtime_fixture(tmp_path)
+    record['run'] = None
+    record['expires'] = time.monotonic() - 1
+    with pytest.raises(ValueError, match='expired'):
+        asyncio.run(controller.validate_dance_entry('dance_test'))
+    record['expires'] = time.monotonic() + 180
+    record['neutral'] = {**record['neutral'], 'saved_at': -1}
+    with pytest.raises(ValueError, match='Neutral or calibration changed'):
+        asyncio.run(controller.validate_dance_entry('dance_test'))
+    assert submitted == []
+
+
+def test_executor_respects_real_step_intervals_and_aborts_late_dance():
+    from modules.robot_base.control.executor import MotionExecutor
+    writes = []
+    async def write(positions):
+        writes.append((time.monotonic(), positions['joint']))
+        await asyncio.sleep(.001)
+    executor = MotionExecutor(SimpleNamespace(write_positions=write))
+    plan = MotionPlan(waypoints=[Waypoint(positions={'joint': i}, timestamp_ms=i * 20) for i in range(6)],
+                      duration_ms=100, metadata={'strict_max_velocity': 50, 'strict_timing_lag_ms': 180})
+    asyncio.run(executor.execute(plan))
+    assert len(writes) == 6
+    assert all((b[1] - a[1]) / (b[0] - a[0]) <= 50.1 for a, b in zip(writes, writes[1:]))
+    writes.clear()
+    plan.metadata['strict_timing_lag_ms'] = .01
+    with pytest.raises(RuntimeError, match='fell behind'):
+        asyncio.run(executor.execute(plan))
+    assert len(writes) < 6
+
+
+@pytest.mark.parametrize('measured', [{}, {'joint': float('nan')}, {'joint': 9}])
+def test_missing_or_unreached_neutral_stops_before_next_phrase(measured):
+    from modules.robot_base.control.executor import MotionExecutor
+    motor = SimpleNamespace(write_positions=AsyncMock(), read_positions=AsyncMock(return_value=measured))
+    plan = MotionPlan(waypoints=[Waypoint(positions={'joint': p}, timestamp_ms=i * 20)
+                                 for i, p in enumerate([1, 0, 1])], duration_ms=40,
+                      metadata={'neutral_checkpoints_ms': [20], 'neutral_positions': {'joint': 0},
+                                'neutral_tolerances': {'joint': 2}})
+    with pytest.raises(RuntimeError, match='neutral was not reached'):
+        asyncio.run(MotionExecutor(motor).execute(plan))
+    assert motor.write_positions.await_count == 2
+
+
+def test_retime_eases_clock_to_rest_without_changing_source():
+    raw = MotionPlan(waypoints=[Waypoint(positions={'joint': 0}, timestamp_ms=0),
+                               Waypoint(positions={'joint': 30}, timestamp_ms=3000)], duration_ms=3000)
+    plan, _ = retime(raw, 3, INFO)
+    steps = [b.positions['joint'] - a.positions['joint'] for a, b in zip(plan.waypoints, plan.waypoints[1:])]
+    assert 0 < steps[0] < max(steps) / 20
+    assert 0 < steps[-1] < max(steps) / 20
+    assert plan.waypoints[-1].positions == {'joint': 30}
+    assert raw.waypoints[0].positions == {'joint': 0}
+
+
+@pytest.mark.parametrize('failure', [None, 'Unsafe entry'])
+def test_route_preflight_before_torque_and_tracked_completion(tmp_path, failure):
+    from tests.unit.test_teaching import fixture
+    from apps.robot_runtime.web.routes.dancing import register_dance_routes
+    from apps.robot_runtime.web.legacy_routes.animations import register_animation_routes
+    from core.event_bus import EventBus
+    from core.event_lifecycle import EventLifecycleClient
+    server, _ = fixture(tmp_path, recording=False)
+    record = {'report': {'song': SONGS[0]}}
+    prepared = {'id': 'dance_test', 'report': record['report'], 'expires_in': 180}
+    server.motion = SimpleNamespace(
+        prepare_dance=AsyncMock(return_value=prepared),
+        dance_catalog=AsyncMock(return_value={'version': 3, 'songs': SONGS}),
+        _dance_record=lambda _: record, _dance_prepared={'dance_test': record},
+        validate_dance_entry=AsyncMock(side_effect=ValueError(failure) if failure else None))
+    server._motion_status = lambda: {'torque_enabled': False, 'current_idle': None, 'is_moving': False}
+    server._fire_and_forget = asyncio.run
+    success = {'ok': True, 'result': {'success': True}}
+    server._publish_lifecycle_request = AsyncMock(return_value=success)
+    server._request_behavior_stop_lifecycle = AsyncMock(return_value=success)
+    server.event_bus = EventBus()
+    server._event_failure_reason = EventLifecycleClient.failure_reason
+    async def admission(intent, **kwargs):
+        assert not intent.metadata.get('synchronous_motion')
+        await server.event_bus.publish('motion.action.result', 'test', {
+            'action_id': kwargs['action_id'], 'state': 'SUCCEEDED'})
+        return success
+    server._request_behavior_intent_lifecycle = AsyncMock(side_effect=admission)
+    register_dance_routes(server)
+    register_animation_routes(server)
+    client = server.app.test_client()
+    assert client.get('/api/dances').json['version'] == 3
+    assert client.post('/api/animations/play', json={'dance': {'operation': 'prepare', 'song_id': 'waterloo'}}).status_code == 200
+    server._publish_lifecycle_request.assert_not_awaited()
+    server._request_behavior_intent_lifecycle.assert_not_awaited()
+    response = client.post('/api/animations/play', json={'dance': {'operation': 'start', 'id': 'dance_test', 'audio_mode': 'laptop_beat'}})
+    assert response.status_code == 200
+    server.motion.validate_dance_entry.assert_awaited_once()
+    status = client.get('/api/dances/status').json
+    assert status['state'] == ('failed' if failure else 'completed')
+    if failure:
+        assert status['error'] == failure
+        server._publish_lifecycle_request.assert_not_awaited()
+        server._request_behavior_intent_lifecycle.assert_not_awaited()
+    else:
+        assert server._publish_lifecycle_request.call_args.kwargs['data']['hold_present']
+        intent = server._request_behavior_intent_lifecycle.call_args.args[0]
+        assert intent.suggested_motion == 'dance_test'
+        assert intent.metadata['async_motion'] is True
+
+
+def test_active_dance_excludes_other_animation_neutral_save_and_second_start(tmp_path):
+    from tests.unit.test_teaching import fixture
+    from apps.robot_runtime.web.routes.dancing import register_dance_routes
+    from apps.robot_runtime.web.legacy_routes.animations import register_animation_routes
+    server, _ = fixture(tmp_path, recording=False)
+    register_dance_routes(server)
+    register_animation_routes(server)
+    server._dance_playback = {'id': 'dance_owner', 'state': 'countdown', 'heartbeat': 0}
+    client = server.app.test_client()
+    for payload in ({'name': 'teach_nod_t01'}, {'dance': {'operation': 'prepare'}}, {'dance': {'operation': 'start', 'id': 'other'}}):
+        assert client.post('/api/animations/play', json=payload).status_code == 409
