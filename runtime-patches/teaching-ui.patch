+/* Real React interactions with a simulated device. Pass a jsdom installation path. */
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { JSDOM } = require(process.argv[2]);
+const frontend = path.resolve(__dirname, '../apps/dashboard/frontend');
+const { buildSync } = require(path.join(frontend, 'node_modules/esbuild'));
+const dom = new JSDOM('<!doctype html><div id="root"></div>', {
+  url: 'http://teaching.test', runScripts: 'dangerously', pretendToBeVisual: true,
+});
+const w = dom.window;
+const state = { capture: { recording: false, teaching_ui_version: 2, supports_save_without_torque_restore: true },
+  motion: {}, neutral: { valid: false }, takes: [], requests: [], failSave: false, failStart: false };
+w.fetch = async (url, init = {}) => {
+  const data = init.body ? JSON.parse(init.body) : {};
+  state.requests.push({ url, data });
+  let result = {};
+  if (url === '/api/auth/session') result = { authenticated: true, csrf_token: 'test' };
+  if (url === '/api/recording/status') result = state.capture;
+  if (url === '/api/animations/status') result = state.motion;
+  if (url === '/api/animations') result = { animations: state.takes.map(t => t.name) };
+  if (url === '/api/recording/takes') result = { takes: state.takes };
+  if (url === '/api/recording/neutral') result = state.neutral;
+  if (url === '/api/recording/start') {
+    if (state.failStart) { state.failStart = false; return new Response(JSON.stringify({ error: 'Release failed' }), { status: 409 }); }
+    result = state.capture = { ...state.capture, name: data.name, recording: true, duration: 4, frames: 120 };
+  }
+  if (url === '/api/recording/stop' && data.operation === 'save_neutral') {
+    assert.equal(data.restore_torque, false);
+    result = state.neutral = { valid: true, neutral: { saved_at: Date.now(), positions: { base_yaw: 3 } } };
+  } else if (url === '/api/recording/stop') {
+    assert.equal(data.restore_torque, false);
+    if (state.failSave) { state.failSave = false; return new Response(JSON.stringify({ error: 'Disk full' }), { status: 503 }); }
+    result = { name: state.capture.name, duration: 4, frames: 120, path: '/test/take.csv' };
+    state.takes.unshift({ ...result, valid: true, modified: Date.now() });
+    state.capture = { ...state.capture, recording: false, last_saved: result };
+  }
+  if (url === '/api/animations/play') {
+    assert.equal(data.teaching, true);
+    state.motion = { motion_active: true, teaching: { name: data.name, state: 'playing' } };
+  }
+  if (url === '/api/animations/stop') state.motion = { motion_active: false, teaching: { state: 'stopped' } };
+  return new Response(JSON.stringify(result));
+};
+const bundle = buildSync({ stdin: { resolveDir: frontend, loader: 'tsx', contents: `
+  import React from 'react';
+  import { createRoot } from 'react-dom/client';
+  import { TeachingView } from './src/views/TeachingView';
+  let root;
+  window.mountTeach = () => { root = createRoot(document.getElementById('root')); root.render(<TeachingView programRunning={true}/>); };
+  window.unmountTeach = () => root.unmount();
+  window.mountTeach();
+` }, bundle: true, format: 'iife', write: false, define: { 'process.env.NODE_ENV': '"production"' } });
+w.eval(bundle.outputFiles[0].text);
+const buttons = () => [...w.document.querySelectorAll('button')];
+const button = text => buttons().find(b => b.textContent.trim() === text);
+const click = text => { const b = button(text); assert.ok(b && !b.disabled, `${text} should be enabled`); b.click(); };
+async function until(predicate) {
+  for (let i = 0; i < 150; i++) {
+    const matched = predicate();
+    await new Promise(r => setTimeout(r, 20));
+    if (matched && predicate()) return;
+  }
+  throw new Error(`UI timeout: ${w.document.body.textContent}`);
+}
+(async () => {
+  try {
+    await until(() => button('Start recording') && !button('Start recording').disabled);
+    click('Start recording');
+    await until(() => w.document.body.textContent.includes('120 frames captured'));
+    assert.equal(button('Start recording').disabled, true);
+    state.failSave = true;
+    click('End & save');
+    await until(() => w.document.body.textContent.includes('Disk full'));
+    assert.equal(state.capture.recording, true);
