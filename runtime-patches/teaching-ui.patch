+def teaching_controller(tmp_path, *, tracking=True, collision=None):
+    server, _ = fixture(tmp_path)
+    server.app.test_client().post('/api/recording/stop', json={'restore_torque': False})
+    submitted = []
+    measured = dict.fromkeys(JOINTS, -2.0)
+
+    async def execute(plan):
+        submitted.append(plan)
+        if tracking:
+            measured.update(plan.waypoints[-1].positions)
+
+    motor = SimpleNamespace(read_positions=AsyncMock(side_effect=lambda: dict(measured)))
+    safety = MotionSafetyFilter(calibration={joint: {'range_min': -100, 'range_max': 100} for joint in JOINTS},
+                                required_motors=set(JOINTS), max_velocity=100, enforce_velocity=True)
+    platform = SimpleNamespace(name='fake', target_position_tolerance=.1, self_collision_check_enabled=True,
+                               validate_self_collision=collision or (lambda plan: plan))
+    controller = MotionController(motor, safety, SimpleNamespace(execute=execute),
+                                  library=FileAnimationLibrary(tmp_path, extension='.csv'), platform=platform)
+    controller._connected = True
+    neutral = dict.fromkeys(JOINTS, 3.0)
+    save_neutral(tmp_path, controller.safe_motion_info(), neutral)
+    return controller, submitted, measured, neutral
+
+
+def test_teaching_replay_keeps_every_recorded_interval_between_neutral_visits(tmp_path):
+    controller, submitted, measured, neutral = teaching_controller(tmp_path)
+    asyncio.run(controller.play_animation('teach_nod_t01', transition_profile='teaching'))
+    assert len(submitted) == 3
+    assert submitted[0].waypoints[0].positions == dict.fromkeys(JOINTS, -2.0)
+    assert submitted[0].waypoints[-1].positions == neutral
+    assert submitted[1].waypoints[0].positions == neutral
+    assert submitted[2].waypoints[-1].positions == neutral == measured
+    plan = submitted[1]
+    assert [frame.positions for frame in plan.waypoints[-3:]] == [dict.fromkeys(JOINTS, value) for value in (0.0, 1.0, .5)]
+    times = [frame.timestamp_ms for frame in plan.waypoints[-3:]]
+    assert times[1] - times[0] == pytest.approx(71, abs=.002)
+    assert times[2] - times[1] == pytest.approx(134, abs=.002)
+    assert plan.metadata['source'] == 'teaching_replay'
+
