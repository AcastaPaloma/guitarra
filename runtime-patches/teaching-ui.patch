+++ b/tests/unit/test_dance_lifecycle.py
@@ -0,0 +1,129 @@
+"""Real web/behavior/event-bus lifecycle with fake motors (never hardware)."""
+import asyncio
+import os
+import time
+
+import pytest
+
+from apps.robot_runtime.web.server import WebServer
+from core.event_bus import EventBus
+from modules.robot_base.behavior.runtime import BehaviorRuntime
+from modules.robot_base.behavior.motion_manager import MotionManager
+from modules.robot_base.behavior.motion_policy import RuleBasedMotionPolicy
+from modules.robot_base.behavior.policy import RuleBasedBehaviorPolicy
+from modules.robot_base.behavior.context_tracker import ContextTracker
+from tests.unit.test_dancing import runtime_fixture, SONGS
+
+
+async def exercise(tmp_path, monkeypatch, outcome='completed', *, realtime=False):
+    import modules.robot_base.control.dance_runtime as controller_module
+    import apps.robot_runtime.web.routes.dance_lifecycle as lifecycle_module
+    countdown = 2.5 if realtime else .12
+    monkeypatch.setattr(controller_module, 'COUNTDOWN_SECONDS', countdown)
+    youtube = outcome.startswith('youtube')
+    if outcome == 'youtube_missing':
+        monkeypatch.setattr(controller_module, 'YOUTUBE_WAIT_SECONDS', .15)
+    controller, submitted, old_run, record = runtime_fixture(tmp_path)
+    record['run'] = None
+    record['report']['song'] = SONGS[0]
+    original_execute = controller._executor.execute
+    body_seconds = 30 if realtime else .3
+    async def fake_execute(plan):
+        await asyncio.sleep(body_seconds if submitted else (2 if realtime else .02))
+        if submitted and outcome == 'failed':
+            raise RuntimeError('Simulated motor write failure')
+        await original_execute(plan)
+    controller._executor.execute = fake_execute
+    bus = EventBus(handler_timeout_s=30 if realtime else .08)
+    if outcome in {'timeout', 'stop_rejected'}:
+        monkeypatch.setattr(lifecycle_module, 'TOTAL_TIMEOUT_SECONDS', .08)
+    if outcome in {'disconnect', 'youtube_disconnect'}:
+        monkeypatch.setattr(controller_module, 'LEASE_SECONDS', .12)
+    tracker = ContextTracker()
+    manager = MotionManager(controller, RuleBasedMotionPolicy(), tracker)
+    behavior = BehaviorRuntime(event_bus=bus, context_tracker=tracker,
+        behavior_policy=RuleBasedBehaviorPolicy(), motion_manager=manager)
+    await behavior.start()
+    server = WebServer(motion_controller=controller, event_bus=bus, loop=asyncio.get_running_loop())
+    # The Stop route must also work when Teach has never been used this process.
+    server._teaching_playback = None
+    if outcome == 'stop_rejected':
+        async def reject_stop(**kwargs):
+            return {'ok': False, 'error': 'Simulated stop acknowledgment failure'}
+        server._request_behavior_stop_lifecycle = reject_stop
+    client = server.app.test_client()
+    try:
+        if outcome == 'safety':
+            controller._safety.emergency_stop()
+        response = await asyncio.to_thread(client.post, '/api/animations/play', json={
+            'dance': {'operation': 'start', 'id': 'dance_test', 'audio_mode': 'youtube' if youtube else 'laptop_beat'}})
+        if outcome == 'safety':
+            assert response.status_code == 409 and 'latched' in response.json['error']
+            assert not submitted and server._dance_playback is None
+            return
+        assert response.status_code == 200
+        run = server._dance_playback
+        stop_requested = False
+        limit = time.monotonic() + (40 if realtime else 4)
+        while run.get('ended_at') is None or server._current_animation:
+            assert time.monotonic() < limit, run
+            if outcome not in {'disconnect', 'youtube_disconnect'} or run['state'] != 'playing':
+                run['heartbeat'] = time.monotonic()  # simulated visible laptop
+            if run['state'] == 'waiting_audio' and outcome not in {'youtube_missing', 'youtube_stopped'} and not run.get('audio_ready'):
+                assert len(submitted) == 1, 'YouTube cannot start the body before verified neutral'
+                acknowledgment = await asyncio.to_thread(client.post, '/api/animations/play', json={
+                    'dance': {'operation': 'youtube_ready', 'id': run['id'], 'start_at': time.time() + .85, 'media_time': 8.5}})
+                assert acknowledgment.status_code == 200
+            if run['state'] == 'countdown' and not run.get('audio_ready') and outcome != 'no_audio':
+                acknowledgment = await asyncio.to_thread(client.post, '/api/animations/play', json={
+                    'dance': {'operation': 'audio_ready', 'id': run['id'], 'start_at': run['start_at']}})
+                assert acknowledgment.status_code == 200
+            if ((outcome == 'stopped' and run['state'] == 'playing') or (outcome == 'youtube_stopped' and run['state'] == 'waiting_audio')) and not stop_requested:
+                stopped = await asyncio.to_thread(client.post, '/api/animations/stop')
+                assert stopped.status_code == 200, stopped.json
+                assert run['state'] == 'stopped'
+                stop_requested = True
+            await asyncio.sleep(.015)
+        final = (await asyncio.to_thread(client.get, '/api/dances/status')).json
+        expected = 'completed' if outcome == 'youtube' else 'stopped' if outcome == 'youtube_stopped' else 'failed' if outcome in {'failed', 'no_audio', 'timeout', 'stop_rejected', 'disconnect', 'youtube_missing', 'youtube_disconnect'} else outcome
+        assert final['state'] == expected, final
+        assert final['ended_at'] and server._current_animation is None
+        assert 'dance_test' not in controller._dance_prepared
+        assert bus.diagnostics()['handler_timeout_count'] == 0
+        if outcome in {'completed', 'youtube'}:
+            assert final['error'] is None and len(submitted) == 2
+            assert submitted[-1].waypoints[-1].positions == record['neutral']['positions']
+        elif outcome == 'failed':
+            assert final['error'] == 'Simulated motor write failure'
+        elif outcome == 'no_audio':
+            assert 'audio was not armed' in final['error'] and len(submitted) == 1
+        elif outcome == 'timeout':
+            assert 'timed out' in final['error']
+        elif outcome == 'stop_rejected':
+            assert 'Simulated stop acknowledgment failure' in final['error']
+            controller._executor.stop.assert_awaited()
+        elif outcome in {'disconnect', 'youtube_disconnect'}:
+            assert 'laptop connection lost' in final['error']
+        elif outcome == 'youtube_missing':
+            assert 'synchronization was not received' in final['error'] and len(submitted) == 1
+        elif outcome in {'stopped', 'youtube_stopped'}:
+            assert final['error'] is None
+        assert not bus._subscribers.get('motion.action.result')
+    finally:
+        await behavior.stop()
+        await bus.stop_background()
+
+
+@pytest.mark.parametrize('outcome', ['completed', 'failed', 'stopped', 'no_audio', 'timeout', 'safety', 'stop_rejected', 'disconnect', 'youtube', 'youtube_missing', 'youtube_stopped', 'youtube_disconnect'])
+def test_full_lifecycle_with_real_event_bus_and_fake_motors(tmp_path, monkeypatch, outcome):
+    asyncio.run(exercise(tmp_path, monkeypatch, outcome))
+
+
+@pytest.mark.skipif(os.environ.get('DANCE_REALTIME_TEST') != '1', reason='opt-in 35-second fake-motor regression')
+def test_full_30_second_dance_survives_default_bus_timeout(tmp_path, monkeypatch):
+    asyncio.run(exercise(tmp_path, monkeypatch, realtime=True))
+
+
+@pytest.mark.skipif(os.environ.get('DANCE_REALTIME_TEST') != '1', reason='opt-in real-time YouTube handshake with fake motors')
+def test_full_30_second_youtube_dance_survives_default_bus_timeout(tmp_path, monkeypatch):
+    asyncio.run(exercise(tmp_path, monkeypatch, outcome='youtube', realtime=True))
