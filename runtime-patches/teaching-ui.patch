@@ -0,0 +1,67 @@
+/* Optional real Chromium/YouTube connectivity check. No robot APIs or motors.
+ * node tests/dancing_youtube_browser_probe.cjs /path/to/node_modules/ws
+ * Browser sound is muted. A blocked embed is reported, never bypassed.
+ */
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const path = require('node:path');
+const os = require('node:os');
+const fs = require('node:fs');
+const { spawn } = require('node:child_process');
+const WebSocket = require(process.argv[2]);
+const frontend = path.resolve(__dirname, '../apps/dashboard/frontend');
+const { buildSync } = require(path.join(frontend, 'node_modules/esbuild'));
+const script = buildSync({ stdin: { resolveDir: frontend, loader: 'ts', contents: `
+import { DanceYouTube } from './src/utils/danceYouTube';
+const state = window.probe = { ready: false, error: '', time: 0 };
+const p = new DanceYouTube(document.getElementById('player'), 'Sj_9CiNkkn4', message => state.error = message);
+p.ready.then(() => state.ready = true).catch(e => state.error = e.message);
+window.playProbe = async () => { try { await p.begin(0, 60); p.assertHealthy(); state.time = p.time; return { time: p.time, duration: p.duration }; } catch(e) { state.error = e.message; return { error: e.message }; } };
+window.endProbe = () => p.destroy();
+` }, bundle: true, write: false, format: 'iife' }).outputFiles[0].text;
+const server = http.createServer((req, res) => {
+  console.log('Probe HTTP ' + req.url);
+  res.setHeader('Referrer-Policy', 'same-origin');
+  if (req.url === '/probe.js') { res.setHeader('Content-Type', 'text/javascript'); res.end(script); }
+  else if (req.url === '/') { res.setHeader('Content-Type', 'text/html'); res.end('<div id="player" style="width:640px;height:390px"></div><script src="/probe.js"></script>'); }
+  else { res.statusCode = 404; res.end(); }
+});
+const delay = ms => new Promise(r => setTimeout(r, ms));
+(async () => {
+  let browser, socket;
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'dance-youtube-probe-'));
+  try {
+    browser = spawn('/usr/bin/chromium', ['--headless=new', '--no-sandbox', '--disable-gpu', '--disable-extensions', '--no-proxy-server', '--mute-audio', '--autoplay-policy=document-user-activation-required', '--remote-debugging-port=0', '--user-data-dir=' + profile, `http://127.0.0.1:${server.address().port}/`], { stdio: ['ignore', 'ignore', 'pipe'] });
+    const endpoint = await new Promise((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error('Chromium startup timeout')), 12000);
+      let log = ''; browser.stderr.on('data', chunk => { log += chunk; const m = log.match(/DevTools listening on (ws:\/\/[^\s]+)/); if (m) { clearTimeout(timer); resolve(m[1]); } });
+    });
+    socket = new WebSocket(endpoint); await new Promise(resolve => socket.once('open', resolve));
+    let seq = 0; const pending = new Map();
+    socket.on('message', raw => { const msg = JSON.parse(raw); if (pending.has(msg.id)) { pending.get(msg.id)(msg); pending.delete(msg.id); } });
+    const send = (method, params = {}, sessionId) => new Promise((resolve, reject) => {
+      const id = ++seq, timer = setTimeout(() => { pending.delete(id); reject(new Error(method + ' timed out')); }, 20000);
+      pending.set(id, msg => { clearTimeout(timer); msg.error ? reject(new Error(JSON.stringify(msg.error))) : resolve(msg.result); });
+      socket.send(JSON.stringify({ id, method, params, ...(sessionId ? { sessionId } : {}) }));
+    });
+    const targets = (await send('Target.getTargets')).targetInfos;
+    console.log('Probe pages: ' + JSON.stringify(targets.map(t => ({ type: t.type, url: t.url }))));
+    const target = targets.find(t => t.type === 'page' && t.url.includes('127.0.0.1')) || targets.find(t => t.type === 'page');
+    const { sessionId } = await send('Target.attachToTarget', { targetId: target.targetId, flatten: true });
+    await send('Runtime.enable', {}, sessionId);
+    await send('Runtime.runIfWaitingForDebugger', {}, sessionId);
+    const evaluate = async (expression, extra = {}) => (await send('Runtime.evaluate', { expression, returnByValue: true, ...extra }, sessionId)).result.value;
+    let status;
+    for (let i = 0; i < 100; i++) { status = await evaluate('window.probe'); if (status?.ready || status?.error) break; await delay(300); }
+    assert.ok(status?.ready, JSON.stringify({ status, page: await evaluate('({url: location.href, text: document.body?.innerText?.slice(0, 1000)})') }));
+    const result = await evaluate('window.playProbe()', { awaitPromise: true, userGesture: true });
+    console.log(JSON.stringify({ embed_ready: status.ready, ...result, motor_requests: 0 }));
+    await evaluate('window.endProbe()');
+    if (result.error) process.exitCode = 2;
+    else assert.ok(result.time > 0 && result.duration > 40);
+  } finally {
+    socket?.close(); browser?.kill('SIGTERM'); server.close();
+    console.log('Temporary browser profile retained at ' + profile);
+  }
+})().catch(error => { console.error(error); process.exitCode = 1; server.close(); });
