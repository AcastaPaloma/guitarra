+.teaching-view { max-width: 1160px; margin: 0 auto; padding: 16px 8px 28px; }
+.teaching-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; }
+.teaching-eyebrow, .teaching-section-label { font-size: 11px; font-weight: 650; letter-spacing: .14em; color: var(--muted); }
+.teaching-heading h1 { font-size: clamp(28px, 4vw, 42px); letter-spacing: -.05em; margin: 9px 0 6px; }
+.teaching-heading p, .teaching-footer { color: var(--muted); margin: 0; font-size: 14px; }
+.teaching-state { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 25px; padding: 10px 14px; font-size: 12px; white-space: nowrap; }
+.teaching-state > span { width: 7px; height: 7px; background: var(--green); border-radius: 50%; }
+.teaching-state.recording > span { background: var(--red); }
+.teaching-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
+.teaching-card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 25px; min-width: 0; }
+.teaching-section-label { display: flex; align-items: center; gap: 9px; margin-bottom: 24px; }
+.teaching-section-label > span { background: var(--panel-2); padding: 4px 7px; border-radius: 5px; }
+.teaching-name { margin-top: 8px; height: 50px; font-size: 19px; }
+.teaching-ideas { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
+.teaching-ideas button { border: 1px solid var(--line); background: transparent; color: var(--muted); border-radius: 20px; padding: 7px 11px; font-size: 12px; cursor: pointer; }
+.teaching-ideas button.selected { color: #ffc18b; border-color: #855330; background: #302319; }
+.teaching-meter { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 182px; gap: 8px; color: var(--muted); font-size: 12px; }
+.teaching-timer { color: var(--text); font-size: 64px; line-height: 1; letter-spacing: -.06em; font-variant-numeric: tabular-nums; font-weight: 550; }
+.teaching-timer small { font-size: 24px; color: var(--muted); margin-left: 6px; }
+.teaching-meter.recording .teaching-timer { color: #ff8e88; }
+.teaching-actions { display: flex; gap: 10px; }
+.teaching-actions .btn { flex: 1; justify-content: center; min-height: 48px; font-size: 13px; }
+.teaching-actions .primary { background: #ef9b59; color: #1e140c; border-color: #ef9b59; }
+.teaching-actions .primary:hover:not(:disabled) { background: #ffaf71; }
+.teaching-filename { color: var(--soft); font-family: ui-monospace, monospace; font-size: 11px; min-height: 14px; text-align: center; overflow-wrap: anywhere; }
+.teaching-hint { display: flex; gap: 10px; color: var(--muted); font-size: 12px; line-height: 1.65; margin: 20px 0 0; }
+.teaching-hint svg { flex-shrink: 0; margin-top: 2px; }
+.teaching-library { display: flex; flex-direction: column; }
+.teaching-library-heading { display: flex; align-items: center; justify-content: space-between; margin: -5px 0 18px; }
+.teaching-library-heading .teaching-section-label { margin: 0; }
+.teaching-takes { min-height: 290px; max-height: 410px; overflow-y: auto; flex: 1; margin: 0 -8px 22px; padding: 2px 8px; }
+.teaching-take { width: 100%; display: flex; align-items: center; gap: 12px; text-align: left; padding: 13px 12px; background: transparent; border: 1px solid transparent; border-radius: 10px; color: var(--text); cursor: pointer; margin-bottom: 5px; }
+.teaching-take.selected { background: #27231f; border-color: #624632; }
+.teaching-take-icon { background: var(--panel-2); padding: 10px; border-radius: 8px; color: #d1a47e; display: inline-flex; }
+.teaching-take strong { display: block; font-size: 13px; font-weight: 550; overflow-wrap: anywhere; }
+.teaching-take small { display: block; color: var(--muted); font-size: 11px; margin-top: 6px; }
+.teaching-selected { color: #e7b68f; font-size: 10px; margin-left: auto; }
+.teaching-empty { height: 100%; min-height: 270px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: var(--soft); }
+.teaching-empty h2 { color: var(--muted); font-size: 16px; margin: 18px 0 0; }
+.teaching-empty p { font-size: 13px; line-height: 1.8; }
+.teaching-error, .teaching-notice { padding: 14px 18px; border-radius: 10px; font-size: 13px; line-height: 1.6; margin-bottom: 20px; }
+.teaching-error { background: #371e1e; border: 1px solid #753535; color: #ffb0aa; }
+.teaching-notice { background: #342b1c; border: 1px solid #65502e; color: #edc58d; }
+.teaching-notice .btn { display: flex; margin-top: 12px; }
+.teaching-message { color: #c1d1bf; font-size: 13px; line-height: 1.7; }
+.teaching-footer { font-size: 12px; line-height: 1.7; margin-top: 22px; }
+.teaching-view button:disabled { opacity: .42; cursor: not-allowed; }
+.teaching-view button:focus-visible { outline: 2px solid #ef9b59; outline-offset: 3px; }
+@media (max-width: 900px) { .teaching-grid { grid-template-columns: 1fr; } .teaching-view { padding: 4px 0; } .teaching-card { padding: 20px; } }
+@media (max-width: 440px) { .teaching-state { padding: 8px; } .teaching-actions { flex-wrap: wrap; } .teaching-actions .btn { flex-basis: 100%; } .teaching-selected { display: none; } }
+.teaching-neutral { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 20px; }
+.teaching-neutral h2 { font-size: 20px; margin: 14px 0 8px; }
+.teaching-neutral p { max-width: 620px; line-height: 1.5; color: var(--text-secondary, #a6a9af); }
+.teaching-neutral .teaching-neutral-status { color: #edc183; font-size: 13px; }
+.teaching-neutral-controls { display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }
+@media (max-width: 760px) {
+  .teaching-neutral { flex-direction: column; align-items: stretch; }
+  .teaching-neutral-controls .btn { width: 100%; }
+}
