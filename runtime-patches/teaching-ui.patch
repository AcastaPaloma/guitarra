+def test_neutral_routes_save_without_torque_and_never_discard_a_take(tmp_path):
+    server, torque = fixture(tmp_path, recording=False)
+    controller, submitted, measured, _ = teaching_controller(tmp_path)
+    server.motion = controller
+    client = server.app.test_client()
+    assert client.get('/api/recording/neutral').json['valid']
+    request = {'operation': 'save_neutral', 'restore_torque': False}
+    result = client.post('/api/recording/stop', json=request)
+    assert result.status_code == 200 and result.json['neutral']['positions'] == measured
+    assert client.get('/api/recording/neutral').json['neutral'] == result.json['neutral']
+    assert torque == submitted == []
+    server._recording_frames = [(1, measured)]
+    assert client.post('/api/recording/stop', json=request).status_code == 409
+    assert server._recording_frames == [(1, measured)]
+    assert client.post('/api/recording/stop', json={'operation': 'save_neutral'}).status_code == 400
