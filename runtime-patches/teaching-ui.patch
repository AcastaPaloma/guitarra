+            <p className="dance-safe"><Check size={15} />Checked: {report.peak_speed.toFixed(0)} / {report.speed_budget.toFixed(0)} speed budget · neutral between phrases</p>
+            <details className="dance-cue-details"><summary>Source takes & speed limits</summary>{report.cues.map((cue, i) => <p key={i}>{cue.name}: {cue.source_window.map(v => v.toFixed(1)).join('–')}s excerpt · {cue.speed.toFixed(2)}× playback / {cue.max_speed.toFixed(2)}× safe cap</p>)}</details>
+          </> : <div className="dance-score-empty"><AudioLines size={28} /><p>Your taught moves become a beat-aligned sequence.<br />Prepare checks every pose, transition, and speed.</p></div>}
+        </div>
+        <div className="dance-controls"><button className="btn" disabled={!ready || locked || bpm < 50 || bpm > 200 || !Number.isFinite(offset) || offset < 0 || Boolean(!useYouTube && attachment && offset + 30 > attachment.buffer.duration)} onClick={() => void prepare()}><Check size={17} />{busy === 'Checking dance' ? 'Checking…' : 'Prepare dance'}</button>
+          <button className="btn ghost" aria-label="Remix choreography" title="Different order and take variation" disabled={!ready || locked} onClick={() => void prepare((variation + 1) % 1000)}><Shuffle size={18} /></button>
+          <button className="btn dance-play" disabled={!ready || locked || !prepared || (useYouTube && !videoReady)} onClick={() => void start()}><Play size={18} />Start 30s dance</button>
+          <button className="btn danger" disabled={!programRunning} onClick={() => void stop()}><Square size={17} />Stop</button>
+        </div>
+        <div className="dance-footer"><button className="btn ghost" disabled={locked || !prepared} onClick={() => void hear()}><Music2 size={16} />{hearing ? 'Stop audio preview' : 'Hear audio only'}</button><span>Start powers motors. Keep the path clear.<br />Stop cancels movement; motor holding stays on.</span></div>
+      </section>
+    </div>
+    <p className="dance-bottom-note">Slower or faster, never beyond the motor budget. Large moves span multiple beats. Keep this tab visible while dancing; leaving it stops the routine.</p>
+  </div>;
+}
diff --git a/apps/dashboard/frontend/src/views/TeachingView.tsx b/apps/dashboard/frontend/src/views/TeachingView.tsx
new file mode 100644
index 0000000..47f726f
--- /dev/null
+++ b/apps/dashboard/frontend/src/views/TeachingView.tsx
@@ -0,0 +1,239 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { Circle, Hand, Play, RefreshCw, Save, Square, Waves, LocateFixed } from 'lucide-react';
+import { dashboardApi, errorMessage } from '../api/dashboardClient';
+import type { AnimationStatus, RecordedTake, RecordingStatus, TeachingNeutral } from '../api/types';
+import { nextTakeName, takeLabel } from '../utils/teaching';
+import { useInterval } from '../hooks/useInterval';
+
+const IDEAS = ['Nod', 'Sway', 'Bounce', 'Look left', 'Look right', 'Head tilt', 'Bow', 'Signature'];
+
+export function TeachingView({ programRunning }: { programRunning: boolean }) {
+  const [label, setLabel] = useState('Nod');
+  const [recording, setRecording] = useState<RecordingStatus>({});
+  const [motion, setMotion] = useState<AnimationStatus>({});
+  const [takes, setTakes] = useState<RecordedTake[]>([]);
+  const [neutral, setNeutral] = useState<TeachingNeutral>({ valid: false });
+  const [names, setNames] = useState<string[]>([]);
+  const [selected, setSelected] = useState('');
+  const [busy, setBusy] = useState('');
+  const [online, setOnline] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const operation = useRef(false);
+  const reading = useRef(false);
+  const generation = useRef(0);
+  const lastCatalog = useRef(0);
+
+  const refresh = useCallback(async (catalog = false) => {
+    if (operation.current || reading.current) return;
+    reading.current = true;
+    const version = generation.current;
+    try {
+      const [capture, animation] = await Promise.all([
+        dashboardApi.getRecordingStatus(), dashboardApi.getAnimationStatus(),
+      ]);
+      if (version !== generation.current) return;
+      setRecording(capture);
+      setMotion(animation);
+      if (animation.teaching?.error) setError(animation.teaching.error);
+      setOnline(true);
+      if (capture.teaching_ui_version === 2 && (catalog || Date.now() - lastCatalog.current > 5000)) {
+        const [library, animations, resting] = await Promise.all([
+          dashboardApi.getRecordedTakes(), dashboardApi.getAnimations(), dashboardApi.getTeachingNeutral(),
+        ]);
+        if (version !== generation.current) return;
+        setTakes(library.takes);
+        setNeutral(resting);
+        setNames(animations.animations || []);
+        setSelected((current) => library.takes.some((take) => take.name === current)
+          ? current : capture.last_saved?.name || library.takes[0]?.name || '');
+        lastCatalog.current = Date.now();
+      }
+    } catch (failure) {
+      if (version === generation.current) {
+        setOnline(false);
+        setError(errorMessage(failure));
+      }
+    } finally {
+      reading.current = false;
+    }
+  }, []);
+
+  useEffect(() => { void refresh(true); }, [refresh, programRunning]);
+  useInterval(() => refresh(), programRunning ? 700 : null);
+
+  const active = Boolean(recording.recording || recording.pending_save);
+  const replaying = ['preparing', 'playing'].includes(motion.teaching?.state || '');
+  useEffect(() => {
+    if (!active) return;
+    const warn = (event: BeforeUnloadEvent) => { event.preventDefault(); event.returnValue = ''; };
+    window.addEventListener('beforeunload', warn);
+    return () => window.removeEventListener('beforeunload', warn);
+  }, [active]);
+
+  const run = async (name: string, action: () => Promise<void>) => {
+    if (operation.current) return;
+    operation.current = true;
+    generation.current += 1;
+    setBusy(name);
+    setError('');
+    setMessage('');
+    try {
+      await action();
+    } catch (failure) {
+      setError(`${errorMessage(failure)}. Check the lamp before trying again.`);
+    } finally {
+      operation.current = false;
+      lastCatalog.current = 0;
+      await refresh(true);
+      setBusy('');
+    }
+  };
+
+  const nextName = nextTakeName(label, names);
+  const supported = recording.teaching_ui_version === 2 && Boolean(recording.supports_save_without_torque_restore);
+  const ready = online && programRunning && supported;
+  const stationary = ready && !active && !busy && !replaying && !motion.motion_active;
+  const chosen = takes.find((take) => take.name === selected);
+  const start = () => run('Starting', async () => {
+    // Disable idle for the session so restoring power cannot restart a dance.
+    await dashboardApi.setIdleAnimation(null);
+    const result = await dashboardApi.startRecording(nextName);
+    setRecording({ ...result, frames: 0, duration: 0, supports_save_without_torque_restore: true, teaching_ui_version: 2 });
+    setMessage('Motors released. Guide your gesture, then save.');
+  });
+  const save = () => run('Saving', async () => {
+    const result = await dashboardApi.saveRecording();
+    setRecording((current) => ({ ...current, recording: false, pending_save: false, last_saved: result }));
+    if (!result.path || !result.frames) throw new Error('No samples were saved');
+    setSelected(result.name || '');
+    setMessage(`Saved ${takeLabel(result.name || '')}. Keep supporting the lamp; motors remain released.`);
+  });
+  const replay = (name = selected) => run('Starting replay', async () => {
+    if (!neutral.valid) throw new Error('Set your neutral pose first');
+    setSelected(name);
+    await dashboardApi.setIdleAnimation(null);
+    await dashboardApi.replayTake(name);
+    setMessage(`Neutral → ${takeLabel(name)} → neutral. Motors will stay on afterward.`);
+  });
+  const positionByHand = () => {
+    if (!window.confirm('Support the lamp’s head and arms before releasing the motors. Ready to position it by hand?')) return;
+    void run('Releasing motors', async () => {
+      await dashboardApi.setIdleAnimation(null);
+      await dashboardApi.stopAnimation();
+      await dashboardApi.setTorque(false);
+      setMessage('Motors released. Hold the lamp upright and centered, then save neutral.');
+    });
+  };
+  const saveNeutral = () => {
+    if (neutral.valid && !window.confirm('Replace the saved neutral with the lamp’s current pose? This changes the start and end of every take.')) return;
+    void run('Saving neutral', async () => {
+      await dashboardApi.setIdleAnimation(null);
+      setNeutral(await dashboardApi.saveTeachingNeutral());
+      setMessage('Neutral saved. Motor power is unchanged; keep supporting the lamp if motors are released.');
+    });
+  };
+  const goNeutral = () => run('Going to neutral', async () => {
+    await dashboardApi.setIdleAnimation(null);
+    await dashboardApi.goToTeachingNeutral();
+    setMessage('Moving to neutral. Keep the path clear; motors stay on afterward.');
+  });
+  const stop = () => run('Stopping replay', async () => {
+    await dashboardApi.stopAnimation();
+    setMessage('Playback stopped. Motor power is unchanged.');
+  });
+  const loadRecorder = () => {
+    if (!window.confirm('Support the lamp’s head and arms. Restarting the robot can release the motors and move the lamp on startup. Ready to restart?')) return;
+    void run('Loading recorder', async () => {
+      const status = await dashboardApi.getProgramStatus();
+      if (status.running) await dashboardApi.stopProgram();
+      await dashboardApi.startProgram();
+      setMessage('Robot starting. Keep supporting the lamp until its motors are holding. The recorder will connect when startup finishes.');
+    });
+  };
+
+  return (
+    <div className="teaching-view">
+      <header className="teaching-heading">
+        <div><span className="teaching-eyebrow">MOVEMENT LIBRARY</span><h1>Teach a move.</h1><p>Guide it. Save it. Play it back.</p></div>
+        <span className={`teaching-state ${recording.recording ? 'recording' : ''}`} role="status">
+          <span />{!online ? 'Connecting' : recording.recording ? 'Recording' : replaying || motion.motion_active ? 'Replaying' : 'Ready'}
+        </span>
+      </header>
+
+      {!programRunning && <div className="teaching-notice">The robot is stopped. Support the lamp before starting it.
+        <button className="btn" disabled={Boolean(busy)} onClick={loadRecorder}>{busy === 'Loading recorder' ? 'Starting…' : 'Start robot'}</button>
+      </div>}
+      {online && !supported && <div className="teaching-notice">
+        The recorder update needs a one-time robot restart. Support the lamp’s head and arms before loading it.
+        <button className="btn" disabled={Boolean(busy) || active} onClick={loadRecorder}>{busy === 'Loading recorder' ? 'Loading…' : 'Load recorder update'}</button>
+      </div>}
+      {error && <div className="teaching-error" role="alert">{error}</div>}
+
+      <section className="teaching-card teaching-neutral" aria-label="Neutral standing pose">
+        <div>
+          <div className="teaching-section-label"><LocateFixed size={16} /> NEUTRAL STANDING POSE</div>
+          <h2>{neutral.valid ? 'Your starting and finishing position.' : 'Set your center first.'}</h2>
+          <p>Support the lamp, release its motors, and position it upright in the middle. Hold still and save this pose once.</p>
+          <p className="teaching-neutral-status">{neutral.valid ? 'Neutral saved · used before and after every take' : neutral.error || 'No neutral saved · replay is locked until you set it'}</p>
+        </div>
+        <div className="teaching-neutral-controls">
+          <button className="btn" disabled={!stationary} onClick={positionByHand}><Hand size={17} />Position by hand</button>
+          <button className="btn" disabled={!stationary} onClick={saveNeutral}><Save size={17} />{busy === 'Saving neutral' ? 'Saving…' : 'Save current pose as neutral'}</button>
+          <button className="btn primary" disabled={!stationary || !neutral.valid} onClick={() => void goNeutral()}><LocateFixed size={17} />Go to neutral</button>
+        </div>
+      </section>
+
+      <div className="teaching-grid">
+        <section className="teaching-card teaching-capture" aria-label="Record a gesture">
+          <div className="teaching-section-label"><Circle size={16} /> NEW TAKE</div>
+          <label className="field-label" htmlFor="gesture-name">Gesture name</label>
+          <input id="gesture-name" className="input teaching-name" value={label} maxLength={70}
+            placeholder="e.g. Sway" disabled={active || Boolean(busy)} onChange={(event) => setLabel(event.target.value)} />
+          <div className="teaching-ideas" aria-label="Gesture ideas">
+            {IDEAS.map((idea) => <button key={idea} className={label === idea ? 'selected' : ''}
+              disabled={active || Boolean(busy)} onClick={() => setLabel(idea)}>{idea}</button>)}
+          </div>
+          <div className={`teaching-meter ${recording.recording ? 'recording' : ''}`}>
+            <span className="teaching-timer">{active ? (recording.duration || 0).toFixed(1) : '0.0'}<small>s</small></span>
+            <span>{active ? `${recording.frames || 0} frames captured` : 'Ready for your next idea'}</span>
+          </div>
+          <div className="teaching-actions">
+            <button className="btn primary" disabled={!ready || active || Boolean(busy) || !nextName} onClick={() => void start()}>
+              <Circle size={18} />{busy === 'Starting' ? 'Starting…' : recording.last_saved ? 'Record again' : 'Start recording'}
+            </button>
+            <button className="btn" disabled={!ready || !active || Boolean(busy)} onClick={() => void save()}>
+              <Save size={18} />{busy === 'Saving' ? 'Saving…' : recording.pending_save ? 'Retry save' : 'End & save'}
+            </button>
+          </div>
+          <p className="teaching-filename">{active ? recording.name : nextName || 'Enter a gesture name'}</p>
+          <p className="teaching-hint"><Hand size={18} />Support the head and arms before Start. Recording releases the motors; saving keeps them released.</p>
+        </section>
+
+        <section className="teaching-card teaching-library" aria-label="Saved takes">
+          <div className="teaching-library-heading"><div className="teaching-section-label"><Waves size={16} /> YOUR TAKES <span>{takes.length}</span></div>
+            <button className="btn ghost" aria-label="Refresh takes" disabled={Boolean(busy)} onClick={() => void refresh(true)}><RefreshCw size={16} /></button>
+          </div>
+          <div className="teaching-takes" role="list" aria-label="Click a take to replay">
+            {!takes.length && <div className="teaching-empty"><Waves size={34} /><h2>Your first move starts here.</h2><p>Give it a name and record a short gesture.<br />Every take is saved separately.</p></div>}
+            {takes.map((take) => <button role="listitem" key={take.name} className={`teaching-take ${selected === take.name ? 'selected' : ''}`}
+              disabled={!stationary || !neutral.valid || !take.valid} aria-label={`Replay ${takeLabel(take.name)}`} onClick={() => void replay(take.name)}>
+              <span className="teaching-take-icon"><Waves size={18} /></span>
+              <span><strong>{takeLabel(take.name)}</strong><small>{take.valid ? `${(take.duration || 0).toFixed(1)}s · ${take.frames} frames` : 'Needs review — replay unavailable'}</small></span>
+              <Play size={16} className="teaching-selected" />
+            </button>)}
+          </div>
+          <div className="teaching-actions">
+            <button className="btn primary" disabled={!stationary || !neutral.valid || !chosen?.valid} onClick={() => void replay()}>
+              <Play size={18} />{busy === 'Starting replay' ? 'Starting…' : 'Replay selected'}
+            </button>
+            <button className="btn" disabled={!online || active || Boolean(busy)} onClick={() => void stop()}><Square size={17} />Stop replay</button>
+          </div>
+          <p className="teaching-hint">Neutral → recorded move → neutral. Gentle transitions connect the poses; your recorded timing stays intact. Replay powers the motors—keep the path clear. Stop cancels the sequence without returning.</p>
+        </section>
+      </div>
+      {message && <p className="teaching-message" role="status">{message}</p>}
+      <p className="teaching-footer">Short gestures work best. For a loop, guide two smooth cycles. Idle stays off throughout your session.</p>
+    </div>
+  );
+}
