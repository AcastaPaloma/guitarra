+def test_hold_seeds_goal_before_power_and_fails_closed_on_bad_read(monkeypatch):
+    monkeypatch.setitem(sys.modules, 'lerobot.motors.feetech', SimpleNamespace(OperatingMode=SimpleNamespace(POSITION=SimpleNamespace(value=0))))
+    calls = []
+    positions = dict.fromkeys(JOINTS, 5.0)
+    bus = SimpleNamespace(
+        motors=dict.fromkeys(JOINTS), protocol_version=1,
+        disable_torque=lambda **kwargs: calls.append('off'),
+        enable_torque=lambda **kwargs: calls.append('on'), write=lambda *args, **kwargs: None,
+        sync_read=lambda register: dict(positions),
+        sync_write=lambda register, values: calls.append((register, values)),
+    )
+    driver = FeetechBusController(motors=dict.fromkeys(JOINTS, 1))
+    driver._connected = True
+    driver._bus = bus
+    driver.enable_torque(hold_present=True)
+    assert calls == ['off', ('Goal_Position', positions), 'on']
+    calls.clear()
+    positions.pop('base_yaw')
+    with pytest.raises(RuntimeError, match='incomplete'):
+        driver.enable_torque(hold_present=True)
+    assert 'on' not in calls and calls[-1] == 'off'
+
+
+@pytest.mark.parametrize('failure', [None, 'collision rejected'])
+@pytest.mark.parametrize('name,explicit', [('teach_nod_t01', True), ('teach_nod_t01', False), ('teaching_neutral', True)])
+def test_replay_reports_completion_or_rejection_and_keeps_teaching_mode(tmp_path, failure, name, explicit):
+    server, torque = fixture(tmp_path)
+    intents = []
+    motor_events = []
+
+    async def intent(request, **kwargs):
+        intents.append(request)
+        return {'ok': True, 'result': {'success': failure is None}}
+
+    async def publish(topic, **kwargs):
+        motor_events.append(kwargs['data'])
+        return {'ok': True, 'result': {'success': True}}
+
+    server.motion = SimpleNamespace(has_animation=lambda name: True, validate_teaching_replay=AsyncMock())
+    server._motion_status = lambda: {'torque_enabled': False, 'current_idle': None}
+    server._animation_csv_path = lambda name: tmp_path / f'{name}.csv'
+    server._request_behavior_intent_lifecycle = intent
+    server._publish_lifecycle_request = publish
+    server._fire_and_forget = asyncio.run
+    server._animation_started_at = None
+    server._last_animation_error = None
+    server._current_animation = None
+    server._animation_name = lambda name: name
+    register_animation_routes(server)
+    client = server.app.test_client()
+    client.post('/api/recording/stop', json={'restore_torque': False})
+    response = client.post('/api/animations/play', json={'name': name, 'teaching': explicit})
+    assert response.status_code == 200
+    server.motion.validate_teaching_replay.assert_awaited_once_with(name)
+    assert motor_events[0]['hold_present'] is True
+    assert intents[0].metadata['teaching_replay'] is True
+    assert intents[0].metadata['transition_profile'] == 'teaching'
+    assert intents[0].metadata['synchronous_motion'] is True
+    status = client.get('/api/animations/status').json['teaching']
+    assert status['state'] == ('failed' if failure else 'completed')
+    assert bool(status['error']) == bool(failure)
+    assert not client.get('/api/animations/status').json['playing']
+    motor_events.clear()
+    intents.clear()
+    server.motion.validate_teaching_replay = AsyncMock(side_effect=ValueError('Invalid neutral'))
+    client.post('/api/animations/play', json={'name': name, 'teaching': explicit})
+    assert server._teaching_playback['state'] == 'failed'
+    assert server._teaching_playback['error'] == 'Invalid neutral'
+    assert motor_events == intents == []  # Preflight failure cannot power motors.
+
