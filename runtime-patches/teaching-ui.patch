+import { useCallback, useEffect, useRef, useState } from 'react';
+import { AudioLines, Check, Disc3, FileAudio, Music2, Play, RefreshCw, Shuffle, Square } from 'lucide-react';
+import { dashboardApi, errorMessage, ApiError } from '../api/dashboardClient';
+import type { DanceCatalog, DanceSong, DanceStatus, PreparedDance } from '../api/types';
+import { analyzeBeats, DanceAudio } from '../utils/danceAudio';
+import { DanceYouTube, nextVideoBeat, parseYouTubeId, videoDrift } from '../utils/danceYouTube';
+import { useInterval } from '../hooks/useInterval';
+import presets from '../../../../../static/dances/catalog.json';
+
+const ACTIVE = ['preparing', 'to_neutral', 'waiting_audio', 'countdown', 'playing', 'finishing', 'stopping'];
+const AXES = [['base_yaw', 'Turn', '#f5b455'], ['base_pitch', 'Lean', '#88bbf2'], ['elbow_pitch', 'Lift', '#bd8bff'], ['wrist_roll', 'Roll', '#78dfca'], ['wrist_pitch', 'Nod', '#f18b86']];
+type AttachedAudio = { buffer: AudioBuffer; name: string };
+
+export function DancingView({ programRunning }: { programRunning: boolean }) {
+  const [catalog, setCatalog] = useState<DanceCatalog | null>(null);
+  const [songId, setSongId] = useState('waterloo');
+  const [bpm, setBpm] = useState(148);
+  const [variation, setVariation] = useState(0);
+  const [offset, setOffset] = useState(0);
+  const [beats, setBeats] = useState<number[] | undefined>();
+  const [analysis, setAnalysis] = useState('Nominal song tempo · attach audio to estimate its actual beats');
+  const [prepared, setPrepared] = useState<PreparedDance | null>(null);
+  const [status, setStatus] = useState<DanceStatus | null>(null);
+  const [busy, setBusy] = useState('');
+  const [error, setError] = useState('');
+  const [needsUpdate, setNeedsUpdate] = useState(false);
+  const [now, setNow] = useState(Date.now());
+  const [attachment, setAttachment] = useState<AttachedAudio | null>(null);
+  const [hearing, setHearing] = useState(false);
+  const [volume, setVolume] = useState(60);
+  const [audioStatus, setAudioStatus] = useState('Audio output: this laptop');
+  const [speakerStatus, setSpeakerStatus] = useState('Checking lamp speaker…');
+  const [useYouTube, setUseYouTube] = useState(true);
