+const frontend = path.resolve(__dirname, '../apps/dashboard/frontend');
+const { buildSync } = require(path.join(frontend, 'node_modules/esbuild'));
+const songs = require('../static/dances/catalog.json');
+const dom = new JSDOM('<div id="root"></div>', { url: 'http://dance.test', runScripts: 'dangerously', pretendToBeVisual: true });
+const w = dom.window, requests = [], players = [];
+let status = {}, blocked = false, rejectSync = false;
+w.YT = { Player: class {
+  constructor(frame, { events }) { this.id = new URL(frame.src).pathname.split('/').pop(); this.events = events; this.state = 2; this.position = 0; this.rate = 1; this.volume = 60; players.push(this); setTimeout(() => events.onReady({}), 5); }
+  getCurrentTime() { return this.position + (this.state === 1 ? (Date.now() - this.started) / 1000 : 0); }
+  getDuration() { return 220; } getVideoUrl() { return 'https://www.youtube.com/watch?v=' + this.id; }
+  getPlayerState() { return this.state; } getPlaybackRate() { return this.rate; }
+  setPlaybackRate(rate) { this.rate = rate; } setVolume(v) { this.volume = v; } getVolume() { return this.volume; } unMute() {} isMuted() { return false; }
+  seekTo(t) { this.position = t; this.started = Date.now(); }
+  playVideo() { if (blocked) { this.events.onAutoplayBlocked({}); return; } this.state = 1; this.started = Date.now(); }
+  pauseVideo() { this.position = this.getCurrentTime(); this.state = 2; this.events.onStateChange({ data: 2 }); }
+  destroy() { this.state = 2; }
+  interrupt(state) { this.position = this.getCurrentTime(); this.state = state; this.events.onStateChange({ data: state }); }
+} };
+w.fetch = async (url, init = {}) => {
+  const data = init.body ? JSON.parse(init.body) : {};
+  requests.push({ url, data }); let result = {};
+  if (url === '/api/auth/session') result = { authenticated: true, csrf_token: 'test' };
+  if (url === '/api/dances') result = { version: 3, songs, neutral_valid: true, safety_latched: false, actions: [] };
+  if (url === '/api/audio/output-devices') result = { devices: [] };
+  if (url === '/api/dances/status') result = { ...status, server_time: Date.now() / 1000 };
+  if (url === '/api/animations/stop') status = { ...status, state: 'stopped' };
+  if (url === '/api/animations/play') {
+    const op = data.dance.operation;
+    if (op === 'prepare') result = { id: 'dance_' + requests.length, report: { song: songs[0], bpm: 148, meter: 4, beats: [0, .405, .811], duration: 30, cues: [], preview: [], peak_speed: 100, speed_budget: 195 } };
+    if (op === 'start') { assert.equal(data.dance.audio_mode, 'youtube'); assert.equal(players.at(-1).state, 1, 'song plays before any motor start'); status = { id: data.dance.id, state: 'waiting_audio', audio_mode: 'youtube' }; }
+    if (op === 'youtube_ready') {
+      if (rejectSync) return new Response(JSON.stringify({ error: 'YouTube synchronization missed its window' }), { status: 409 });
+      assert.equal(status.state, 'waiting_audio');
+      assert.ok(data.dance.start_at - Date.now() / 1000 > .75);
+      status = { ...status, state: 'countdown', start_at: data.dance.start_at, media_time: data.dance.media_time, audio_ready: true };
+    }
+    if (op !== 'prepare') result = { ...status, server_time: Date.now() / 1000 };
+  }
+  return new Response(JSON.stringify(result));
+};
+const bundle = buildSync({ stdin: { resolveDir: frontend, loader: 'tsx', contents: `
+import React from 'react'; import { createRoot } from 'react-dom/client'; import { DancingView } from './src/views/DancingView';
+const root = createRoot(document.getElementById('root')); root.render(<DancingView programRunning={true}/>); window.unmountDance = () => root.unmount();
+` }, bundle: true, write: false, format: 'iife', define: { 'process.env.NODE_ENV': '"production"' } });
+w.eval(bundle.outputFiles[0].text);
+const button = label => [...w.document.querySelectorAll('button')].find(b => b.textContent.trim() === label);
+const click = label => { const b = button(label); assert.ok(b && !b.disabled, label + ' enabled'); b.click(); };
+const ops = op => requests.filter(r => r.data.dance?.operation === op);
+async function until(check) { for (let i = 0; i < 300; i++) { await new Promise(r => setTimeout(r, 20)); if (check()) return; } throw new Error('UI timeout: ' + w.document.body.textContent); }
+async function prepare() { await until(() => !button('Prepare dance').disabled); click('Prepare dance'); await until(() => !button('Start 30s dance').disabled); }
+async function start() { await prepare(); click('Start 30s dance'); await until(() => status.state === 'countdown'); }
+(async () => {
+  try {
+    await until(() => w.document.body.textContent.includes('YouTube ready'));
+    assert.equal(w.document.querySelector('iframe').referrerPolicy, 'strict-origin-when-cross-origin');
+    assert.equal(w.document.querySelector('[aria-label="Soundtrack source"]').value, 'youtube');
+    await start();
+    assert.equal(ops('youtube_ready').length, 1); assert.equal(ops('audio_ready').length, 0);
+    assert.ok(Math.abs(players.at(-1).getCurrentTime() - (status.media_time + Date.now() / 1000 - status.start_at)) < .1);
+    players.at(-1).interrupt(3);
+    await until(() => status.state === 'stopped' && !button('Prepare dance').disabled);
+    assert.ok(w.document.body.textContent.includes('buffered'));
+    assert.equal(players.at(-1).state, 2);
+    await start(); status = { ...status, state: 'completed' };
+    await until(() => w.document.body.textContent.includes('Complete · back at neutral'));
+    assert.equal(players.at(-1).state, 2); assert.equal(button('Start 30s dance').disabled, true);
+    await prepare(); blocked = true; const before = ops('start').length;
+    click('Start 30s dance'); await until(() => w.document.body.textContent.includes('YouTube blocked playback') && !button('Prepare dance').disabled);
+    assert.equal(ops('start').length, before, 'autoplay block cannot start motors'); blocked = false;
+    await start(); players.at(-1).position += 3;
+    await until(() => status.state === 'stopped' && !button('Prepare dance').disabled);
