diff --git a/apps/dashboard/frontend/src/utils/danceAudio.ts b/apps/dashboard/frontend/src/utils/danceAudio.ts
new file mode 100644
index 0000000..dd12f49
--- /dev/null
+++ b/apps/dashboard/frontend/src/utils/danceAudio.ts
@@ -0,0 +1,141 @@
+/** Local-only audio analysis. No audio data or file is sent to the lamp. */
+export interface BeatAnalysis { bpm: number; beats: number[]; firstBeat: number; confidence: number }
+
+export function analyzeBeats(samples: Float32Array, sampleRate: number, priorBpm: number): BeatAnalysis {
+  if (!Number.isFinite(sampleRate) || sampleRate < 8000 || samples.length < sampleRate * 30) throw new Error('Choose an excerpt with at least 30 seconds of audio');
+  if (!Number.isFinite(priorBpm) || priorBpm < 50 || priorBpm > 200) throw new Error('Tempo must be 50–200 BPM');
+  const hop = Math.max(1, Math.round(sampleRate / 100));
+  const envelope: number[] = [];
+  let previous = 0;
+  for (let i = 0; i + hop < Math.min(samples.length, sampleRate * 32); i += hop) {
+    let energy = 0;
+    for (let j = i; j < i + hop; j++) {
+      const difference = samples[j] - (j ? samples[j - 1] : 0);
+      energy += samples[j] ** 2 + difference ** 2 * .5;
+    }
+    const level = Math.sqrt(energy / hop);
+    envelope.push(Math.max(0, level - previous * .85));
+    previous = level;
+  }
+  const maximum = Math.max(...envelope);
+  if (maximum < 1e-5) throw new Error('No clear beats detected—use the tempo grid or choose another excerpt');
+  const env = envelope.map(v => v / maximum);
+  const hz = sampleRate / hop;
+  let bestBpm = priorBpm, bestScore = -1;
+  // Use the song's nominal tempo to avoid common half/double-time ambiguity.
+  for (let bpm = Math.max(50, priorBpm * .85); bpm <= Math.min(200, priorBpm * 1.15); bpm += .25) {
+    const lag = 60 * hz / bpm;
+    let score = 0, normalizer = 0;
+    for (let i = Math.ceil(lag); i < env.length; i++) {
+      const pos = i - lag, left = Math.floor(pos), fraction = pos - left;
+      score += env[i] * (env[left] * (1 - fraction) + (env[left + 1] || 0) * fraction);
+      normalizer += env[i] ** 2;
+    }
+    score /= Math.max(normalizer, 1e-8);
+    if (score > bestScore) { bestScore = score; bestBpm = bpm; }
+  }
+  const period = 60 / bestBpm;
+  let phase = 0, phaseScore = -1;
+  for (let p = 0; p < period; p += .01) {
+    let score = 0;
+    for (let t = p; t < 29.5; t += period) score += env[Math.min(env.length - 1, Math.round(t * hz))];
+    if (score > phaseScore) { phaseScore = score; phase = p; }
+  }
+  const beats = [0];
+  for (let t = phase + period; t - phase <= 30; t += period) {
+    let found = t, strength = -1;
+    const radius = Math.min(.07, period * .12);
+    for (let candidate = t - radius; candidate <= t + radius; candidate += .01) {
+      const value = env[Math.round(candidate * hz)] || 0;
+      if (value > strength) { strength = value; found = candidate; }
+    }
+    const relative = Math.round((found - phase) * 1000) / 1000;
+    if (relative <= 30 && relative > beats[beats.length - 1] + .25) beats.push(relative);
+  }
+  return { bpm: Math.round(bestBpm * 100) / 100, beats, firstBeat: phase, confidence: Math.max(0, Math.min(1, bestScore)) };
+}
+
+export class DanceAudio {
+  private context: AudioContext | null = null;
+  private nodes: AudioScheduledSourceNode[] = [];
+  private bus: GainNode | null = null;
+  private volume = .6;
+  private playbackId = 0;
+
+  get isRunning() { return this.context?.state === 'running'; }
+
+  setVolume(volume: number) {
+    if (!Number.isFinite(volume) || volume < 0 || volume > 1) throw new Error('Audio volume must be between 0 and 100%');
+    this.volume = volume;
+    if (this.bus) this.bus.gain.value = volume;
+  }
+
+  async unlock() {
+    if (!this.context || this.context.state === 'closed') {
+      const Context = globalThis.AudioContext || (globalThis as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
+      if (!Context) throw new Error('This browser does not support audio playback. Use a browser with Web Audio enabled.');
+      this.context = new Context();
+    }
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([this.context.resume(), new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error('Browser audio is blocked. Enable sound for this page and use Test laptop audio.')), 2500);
+      })]);
+    } finally { clearTimeout(timer); }
+    if (!this.isRunning) throw new Error('Browser audio is blocked. Enable sound for this page and use Test laptop audio.');
+  }
+
+  async decode(file: File) {
+    if (file.size > 25 * 1024 * 1024) throw new Error('Use an audio file smaller than 25 MB');
+    await this.unlock();
+    const buffer = await this.context!.decodeAudioData(await file.arrayBuffer());
+    if (buffer.duration < 30) throw new Error('Audio needs at least 30 seconds');
+    return buffer;
+  }
+
+  schedule(delay: number, beats: number[], meter: number, buffer?: AudioBuffer, offset = 0, onEnded?: () => void) {
+    if (!this.context || this.context.state !== 'running') throw new Error('Audio is suspended. Start again to unlock it.');
+    if (!Number.isFinite(delay) || delay < .1) throw new Error('Missed the synchronized start; try again');
+    if (buffer && (!Number.isFinite(offset) || offset < 0 || offset + 30 > buffer.duration + .001)) throw new Error('Select a full 30-second excerpt');
+    this.stop();
+    const playbackId = this.playbackId;
+    const ctx = this.context;
+    const when = ctx.currentTime + delay;
+    this.bus = ctx.createGain();
+    this.bus.gain.value = this.volume;
+    this.bus.connect(ctx.destination);
+    if (buffer) {
+      const source = ctx.createBufferSource();
+      source.buffer = buffer;
+      source.connect(this.bus);
+      source.start(when, offset, 30);
+      this.nodes.push(source);
+    } else {
+      for (let i = 0; i < beats.length; i++) {
+        if (beats[i] >= 30) break;
+        const oscillator = ctx.createOscillator(), gain = ctx.createGain();
+        oscillator.type = 'sine';
+        oscillator.frequency.value = i % meter === 0 ? 660 : 330;
+        gain.gain.setValueAtTime(.001, when + beats[i]);
+        gain.gain.exponentialRampToValueAtTime(.4, when + beats[i] + .005);
+        gain.gain.exponentialRampToValueAtTime(.001, when + beats[i] + .065);
+        oscillator.connect(gain); gain.connect(this.bus);
+        oscillator.start(when + beats[i]); oscillator.stop(when + Math.min(30, beats[i] + .075));
+        this.nodes.push(oscillator);
+      }
+    }
+    const last = this.nodes[this.nodes.length - 1];
+    if (last) last.onended = () => {
+      if (this.playbackId === playbackId) onEnded?.();
+    };
+  }
+
+  stop() {
+    this.playbackId++;
+    for (const node of this.nodes) { try { node.stop(); node.disconnect(); } catch { /* already ended */ } }
+    this.nodes = [];
+    this.bus?.disconnect(); this.bus = null;
+  }
+
+  close() { this.stop(); void this.context?.close(); this.context = null; }
+}
diff --git a/apps/dashboard/frontend/src/utils/danceYouTube.ts b/apps/dashboard/frontend/src/utils/danceYouTube.ts
new file mode 100644
index 0000000..01c7305
--- /dev/null
+++ b/apps/dashboard/frontend/src/utils/danceYouTube.ts
@@ -0,0 +1,139 @@
+/** Visible official YouTube embed; no downloading, audio extraction or ad bypass. */
+interface Player {
+  playVideo(): void; pauseVideo(): void; seekTo(seconds: number, allowSeekAhead: boolean): void;
+  setVolume(volume: number): void; unMute(): void; isMuted(): boolean; getVolume(): number;
+  setPlaybackRate(rate: number): void; getPlaybackRate(): number;
+  getPlayerState(): number; getCurrentTime(): number; getDuration(): number; getVideoUrl(): string;
+  destroy(): void;
+}
+interface YouTubeAPI { Player: new (element: HTMLElement, options: { events: Record<string, (event: { data: number }) => void> }) => Player }
+declare global { interface Window { YT?: YouTubeAPI; onYouTubeIframeAPIReady?: () => void } }
+let loading: Promise<YouTubeAPI> | null = null;
+
+export function parseYouTubeId(value: string): string {
+  const text = value.trim();
+  if (/^[\w-]{11}$/.test(text)) return text;
+  try {
+    const url = new URL(text);
+    if (!['https:', 'http:'].includes(url.protocol)) throw new Error();
+    const host = url.hostname.replace(/^www\.|^m\./, '');
+    const id = host === 'youtu.be' ? url.pathname.slice(1) : ['youtube.com', 'youtube-nocookie.com'].includes(host)
+      ? (url.searchParams.get('v') || url.pathname.match(/^\/(?:embed|shorts)\/([\w-]{11})$/)?.[1]) : '';
+    if (id && /^[\w-]{11}$/.test(id)) return id;
+  } catch { /* only YouTube URLs and exact IDs are accepted */ }
+  throw new Error('Paste a YouTube video link or its 11-character video ID');
+}
+
+export function nextVideoBeat(mediaTime: number, firstBeat: number, bpm: number, meter: number, serverNow: number) {
+  if (![mediaTime, firstBeat, bpm, meter, serverNow].every(Number.isFinite) || mediaTime < 0 || firstBeat < 0 || bpm < 50 || bpm > 200 || ![4, 5].includes(meter)) throw new Error('Invalid video beat timing');
+  const bar = 60 / bpm * meter;
+  const mediaStart = firstBeat + Math.max(0, Math.ceil((mediaTime + 1.5 - firstBeat) / bar)) * bar;
+  return { start_at: serverNow + mediaStart - mediaTime, media_time: mediaStart };
+}
+
+export function videoDrift(mediaTime: number, mediaStart: number, serverNow: number, startAt: number) {
+  return mediaTime - (mediaStart + serverNow - startAt);
+}
+
+function loadAPI(): Promise<YouTubeAPI> {
+  if (window.YT?.Player) return Promise.resolve(window.YT);
+  if (loading) return loading;
+  loading = new Promise((resolve, reject) => {
+    const script = document.createElement('script');
+    const previous = window.onYouTubeIframeAPIReady;
+    const timer = setTimeout(() => fail(), 12000);
+    const fail = () => { clearTimeout(timer); script.remove(); loading = null; reject(new Error('YouTube could not load. Check your connection/content blocker, then reload this tab.')); };
+    window.onYouTubeIframeAPIReady = () => { previous?.(); clearTimeout(timer); if (window.YT?.Player) resolve(window.YT); else fail(); };
+    script.src = 'https://www.youtube.com/iframe_api'; script.async = true;
+    script.onerror = fail; document.head.appendChild(script);
+  });
+  return loading;
+}
+
+export class DanceYouTube {
+  private player: Player | null = null;
+  private dead = false;
+  private isReady = false;
+  private failure = '';
+  private attempt = 0;
+  private watching = false;
+  private progress: { media: number; wall: number } | null = null;
+  private interrupt: (message: string) => void;
+  private readyTimer: ReturnType<typeof setTimeout> | undefined;
+  readonly videoId: string;
+  readonly ready: Promise<void>;
+
+  constructor(container: HTMLElement, videoId: string, onInterrupt: (message: string) => void) {
+    this.videoId = videoId;
+    this.interrupt = onInterrupt;
+    this.ready = loadAPI().then(api => new Promise<void>((resolve, reject) => {
+      if (this.dead) { resolve(); return; }
+      // The dashboard uses Referrer-Policy: same-origin. Override only this
+      // iframe before its first navigation, supplying YouTube's required origin.
+      const frame = document.createElement('iframe');
+      const params = new URLSearchParams({ enablejsapi: '1', origin: window.location.origin, playsinline: '1', controls: '1', rel: '0' });
+      frame.referrerPolicy = 'strict-origin-when-cross-origin';
+      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
+      frame.title = 'YouTube dance soundtrack'; frame.allowFullscreen = true;
+      frame.src = `https://www.youtube-nocookie.com/embed/${parseYouTubeId(videoId)}?${params}`;
+      container.replaceChildren(frame);
+      const timer = this.readyTimer = setTimeout(() => reject(new Error('YouTube player did not become ready. Reload or choose another video.')), 12000);
+      const failed = (message: string) => {
+        this.failure = message; clearTimeout(timer); reject(new Error(message));
+        if (this.watching) this.interrupt(message);
+      };
+      this.player = new api.Player(frame, { events: {
+        onReady: () => { this.isReady = true; clearTimeout(timer); resolve(); },
+        onError: event => failed(`YouTube cannot play this video (error ${event.data}). Choose another link; no dance will start.`),
+        onAutoplayBlocked: () => failed('YouTube blocked playback. Click Play inside the video, then try Start again.'),
+        onStateChange: event => {
+          if (this.watching && event.data !== 1) this.interrupt('YouTube paused, buffered or ended. Dance stopped; prepare again.');
+        },
+        onPlaybackRateChange: event => { if (this.watching && event.data !== 1) this.interrupt('YouTube playback speed changed. Dance stopped.'); },
+      } });
+    }));
+  }
+
+  get time() { return this.isReady ? this.player?.getCurrentTime() ?? 0 : 0; }
+  get duration() { return this.isReady ? this.player?.getDuration() ?? 0 : 0; }
+  setVolume(volume: number) { if (this.isReady) this.player?.setVolume(volume); }
+
+  /** Called directly by a click, before awaiting any network/motor operation. */
+  async begin(offset: number, volume: number) {
+    if (!this.player || this.dead || !this.isReady) throw new Error('Wait for the YouTube player to load');
+    if (!Number.isFinite(offset) || offset < 0 || volume <= 0) throw new Error('Choose a valid video start and turn up laptop volume');
+    this.watching = false; this.failure = ''; this.progress = null;
+    const attempt = ++this.attempt, player = this.player;
+    player.setPlaybackRate(1); player.setVolume(volume); player.unMute();
+    player.seekTo(offset, true); player.playVideo();
+    const deadline = performance.now() + 15000;
+    let sample: { media: number; wall: number } | null = null;
+    while (performance.now() < deadline) {
+      if (this.dead || attempt !== this.attempt) throw new Error('Video start cancelled');
+      if (this.failure) throw new Error(this.failure);
+      const media = player.getCurrentTime(), wall = performance.now();
+      if (player.getPlayerState() === 1 && media >= Math.max(0, offset - .3) && media < offset + 3 && player.getDuration() - media >= 40) {
+        if (sample && wall - sample.wall >= 300 && Math.abs((media - sample.media) - (wall - sample.wall) / 1000) < .15) {
+          this.progress = { media, wall }; return;
+        }
+        if (!sample) sample = { media, wall };
+      } else sample = null;
+      await new Promise(resolve => setTimeout(resolve, 50));
+    }
+    throw new Error('YouTube is not playing the selected song yet. Finish any ad/sign-in, click Play in the video, then retry. Choose an earlier start if less than 40 seconds remain.');
+  }
+
+  watch() { this.watching = true; }
+  assertHealthy() {
+    const p = this.player;
+    if (!p || !this.isReady || this.failure) throw new Error(this.failure || 'YouTube player unavailable');
+    if (p.getPlayerState() !== 1 || p.getPlaybackRate() !== 1 || p.isMuted() || p.getVolume() <= 0) throw new Error('YouTube paused, buffered, muted or changed speed. Dance stopped.');
+    if (parseYouTubeId(p.getVideoUrl()) !== this.videoId) throw new Error('YouTube video changed. Dance stopped.');
+    const media = p.getCurrentTime(), wall = performance.now();
+    if (!Number.isFinite(media)) throw new Error('YouTube timing unavailable');
+    if (this.progress && wall - this.progress.wall > 700 && media - this.progress.media < .1) throw new Error('YouTube playback stalled. Dance stopped.');
+    if (!this.progress || media - this.progress.media > .1) this.progress = { media, wall };
+  }
+  pause() { this.watching = false; this.attempt++; if (this.isReady) this.player?.pauseVideo(); }
+  destroy() { this.dead = true; this.watching = false; this.attempt++; clearTimeout(this.readyTimer); this.player?.destroy(); this.player = null; }
+}
