+"""Persistent, calibration-bound neutral poses and faithful teaching sequences."""
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import time
+from pathlib import Path
+
+from core.domain.motion import MotionPlan, Waypoint
+from .safe_motion import target_plan, validate_plan, validate_positions
+
+NEUTRAL_ACTION = "teaching_neutral"
+NEUTRAL_FILE = "teaching_neutral.json"
+
+
+def load_neutral(directory: Path, info: dict) -> dict | None:
+    path = directory / NEUTRAL_FILE
+    if not path.exists():
+        return None
+    data = json.loads(path.read_text())
+    if not isinstance(data, dict) or type(data.get("schema_version")) is not int or data["schema_version"] != 1:
+        raise ValueError("Saved neutral is invalid; set it again")
+    for field in ("robot_id", "calibration_id", "units"):
+        if not info.get(field) or data.get(field) != info[field]:
+            raise ValueError("The robot or calibration changed; set neutral again")
+    data["positions"] = validate_positions(data.get("positions"), info["joints"], complete=True)
+    return data
+
+
+def save_neutral(directory: Path, info: dict, positions: dict) -> dict:
+    if any(not info.get(field) for field in ("robot_id", "calibration_id", "units")):
+        raise ValueError("Robot and calibration identity are required")
+    data = {"schema_version": 1, "saved_at": time.time(),
+            **{field: info[field] for field in ("robot_id", "calibration_id", "units")},
+            "positions": validate_positions(positions, info["joints"], complete=True)}
+    directory.mkdir(parents=True, exist_ok=True)
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile(mode="w", dir=directory, suffix=".tmp", delete=False) as handle:
+            temporary = handle.name
+            json.dump(data, handle, indent=2, allow_nan=False)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, directory / NEUTRAL_FILE)
+        temporary = None
+        descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+    finally:
+        if temporary:
+            os.unlink(temporary)
+    return data
+
+
+def join_plans(*plans: MotionPlan, metadata=None) -> MotionPlan:
+    frames = []
+    offset = 0.0
+    for plan in plans:
+        if not plan.waypoints:
+            raise ValueError("Cannot join an empty motion")
+        if frames:
+            first = plan.waypoints[0].positions
+            if set(first) != set(frames[-1].positions) or any(abs(first[joint] - frames[-1].positions[joint]) > 1e-8 for joint in first):
+                raise ValueError("Teaching sequence has a discontinuous join")
+            # Keep the next segment's exact first target, including the raw take.
+            frames[-1] = Waypoint(positions=dict(first), timestamp_ms=offset)
+        frames.extend(Waypoint(positions=dict(frame.positions), timestamp_ms=offset + frame.timestamp_ms)
+                      for frame in (plan.waypoints[1:] if frames else plan.waypoints))
+        offset += plan.duration_ms
+    return MotionPlan(motion_type="direct", waypoints=frames, duration_ms=offset,
+                      metadata=dict(metadata or {}))
+
+
+def teaching_sequence(raw, current, neutral, info, fps):
+    """Return neutral entry, optional faithful action, return, and full preflight."""
+    limits, velocity = info["joints"], info["max_velocity_units_s"]
+    target = validate_positions(neutral["positions"], limits, complete=True)
+    entry = target_plan(current, target, limits, velocity, fps)
+    entry.metadata.update(source="teaching_neutral", phase="to_neutral")
+    if raw is None:
+        return [entry], entry
+    validate_plan(raw, limits, velocity)
+    bridge = target_plan(target, raw.waypoints[0].positions, limits, velocity, fps)
+    action = join_plans(bridge, raw, metadata={"source": "teaching_replay", "phase": "action",
+                                              "recorded_start_ms": bridge.duration_ms,
+                                              "recorded_end_ms": bridge.duration_ms + raw.duration_ms})
+    ending = target_plan(raw.waypoints[-1].positions, target, limits, velocity, fps)
+    ending.metadata.update(source="teaching_neutral", phase="return_to_neutral")
+    complete = join_plans(entry, action, ending, metadata={"source": "teaching_sequence"})
+    validate_plan(complete, limits, velocity)
+    return [entry, action, ending], complete
