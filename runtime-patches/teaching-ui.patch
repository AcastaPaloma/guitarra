+"""Compile beat-aligned, speed-bounded phrases from the operator's saved takes.
+
+No hardware access. Original recordings are never edited. Tempo is a schedule,
+not permission to increase amplitude or exceed the calibrated velocity limit.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from bisect import bisect_right
+from pathlib import Path
+
+from core.domain.motion import MotionPlan, Waypoint
+from .safe_motion import number, parse_clip, resample_plan, target_plan, validate_plan, validate_positions
+from .teaching import join_plans
+
+DURATION = 30.0
+SPEED_FRACTION = 0.65
+MAX_RATE = 2.0
+RAMP_FRACTION = .1
+SONGS = json.loads((Path(__file__).resolve().parents[3] / "static/dances/catalog.json").read_text())
+
+
+def song_by_id(identifier):
+    return next((dict(song) for song in SONGS if song["id"] == identifier), None)
+
+
+def peak_speed(plan):
+    return max((abs(b.positions[j] - a.positions[j]) / ((b.timestamp_ms - a.timestamp_ms) / 1000)
+                for a, b in zip(plan.waypoints, plan.waypoints[1:]) for j in a.positions), default=0.0)
+
+
+def phrase_from_take(raw, seconds=3.2):
+    """Choose a contiguous energetic phrase; retain a complete short take.
+
+    A long hand-guided take often contains several cycles. The selected window
+    is disclosed in the preview; it is not represented as the full recording.
+    """
+    if raw.duration_ms <= seconds * 1000:
+        return raw, (0.0, raw.duration_ms / 1000)
+    frames = raw.waypoints
+    travel = [0.0]
+    for a, b in zip(frames, frames[1:]):
+        travel.append(travel[-1] + max(abs(b.positions[j] - a.positions[j]) for j in a.positions))
+    right, best = 1, (float('-inf'), 0, 1)
+    for left, frame in enumerate(frames[:-1]):
+        while right + 1 < len(frames) and frames[right + 1].timestamp_ms - frame.timestamp_ms <= seconds * 1000:
+            right += 1
+        if right <= left or frames[right].timestamp_ms - frame.timestamp_ms < seconds * 900:
+            continue
+        score = travel[right] - travel[left]
+        if score > best[0]:
+            best = (score, left, right)
+    _, left, right = best
+    start = frames[left].timestamp_ms
+    selected = [Waypoint(positions=dict(f.positions), timestamp_ms=f.timestamp_ms - start) for f in frames[left:right + 1]]
+    return MotionPlan(waypoints=selected, duration_ms=selected[-1].timestamp_ms), (start / 1000, frames[right].timestamp_ms / 1000)
+
+
+def retime(plan, seconds, info, fps=30):
+    seconds = number(seconds, "action duration")
+    if seconds <= 0:
+        raise ValueError("Action duration must be positive")
+    speed = plan.duration_ms / (seconds * 1000)
+    budget = info["max_velocity_units_s"] * SPEED_FRACTION
+    if speed > MAX_RATE + 1e-8 or peak_speed(plan) * speed / (1 - RAMP_FRACTION) > budget + 1e-6:
+        raise ValueError("Requested tempo exceeds this action's safe speed")
+    def phase(t):
+        if t > 1 - RAMP_FRACTION:
+            return 1 - phase(1 - t)
+        if t < RAMP_FRACTION:
+            u = t / RAMP_FRACTION
+            return RAMP_FRACTION * (u**3 - .5 * u**4) / (1 - RAMP_FRACTION)
+        return (t - RAMP_FRACTION / 2) / (1 - RAMP_FRACTION)
+    # Ease the clock, not the recorded coordinates: rest at both joins without
+    # inventing a pose. Peak clock rate is analytically <= 1/(1-ramp_fraction).
+    source_times = [f.timestamp_ms for f in plan.waypoints]
+    steps = max(2, math.ceil(seconds * fps))
+    frames = []
+    for i in range(steps + 1):
+        source_time = phase(i / steps) * plan.duration_ms
+        right = min(len(source_times) - 1, max(1, bisect_right(source_times, source_time)))
+        a, b = plan.waypoints[right - 1:right + 1]
+        fraction = max(0, min(1, (source_time - a.timestamp_ms) / (b.timestamp_ms - a.timestamp_ms)))
+        frames.append(Waypoint(positions={j: a.positions[j] + (b.positions[j] - a.positions[j]) * fraction for j in a.positions},
+                               timestamp_ms=seconds * 1000 * i / steps))
+    scaled = MotionPlan(waypoints=frames, duration_ms=seconds * 1000)
+    validate_plan(scaled, info["joints"], budget)
+    return scaled, speed
+
+
+def stretch_connector(plan, seconds, fps):
+    if seconds * 1000 + 1e-6 < plan.duration_ms:
+        raise ValueError("A connector cannot be accelerated")
+    scale = seconds * 1000 / plan.duration_ms
+    return resample_plan(MotionPlan(waypoints=[Waypoint(positions=dict(f.positions), timestamp_ms=f.timestamp_ms * scale)
+                                               for f in plan.waypoints], duration_ms=seconds * 1000), fps)
+
+
+def beat_grid(bpm, supplied=None):
+    bpm = number(bpm, "tempo")
+    if not 50 <= bpm <= 200:
+        raise ValueError("Tempo must be between 50 and 200 BPM")
+    if supplied is None:
+        return [round(i * 60 / bpm, 6) for i in range(math.floor(DURATION * bpm / 60) + 1)]
+    if not isinstance(supplied, list) or not 16 <= len(supplied) <= 102:
+        raise ValueError("Beat grid must contain 16–102 times for the 30-second excerpt")
+    beats = [number(v, "beat time") for v in supplied]
+    if abs(beats[0]) > 1e-6 or not 28 <= beats[-1] <= DURATION:
+        raise ValueError("Beat grid must start at zero and cover the excerpt")
+    if any(not .25 <= b - a <= 1.3 for a, b in zip(beats, beats[1:])):
+        raise ValueError("Beat times must increase at a supported tempo")
+    return beats
+
+
+def load_actions(directory: Path, info, collision_check):
+    actions, rejected = [], []
+    for path in sorted(directory.glob("teach_*.csv"), reverse=True):
+        try:
+            # A recording may need slowing before it is playable. Strictly
+            # validate its positions/times first, then compute its safe rate.
+            raw_bytes = path.read_bytes()
+            raw = parse_clip(raw_bytes, info["joints"], 1e12)
+            role = path.stem.removeprefix("teach_").rsplit("_t", 1)[0]
+            phrase, window = phrase_from_take(raw, 4.5 if role == "bow" else 3.2)
+            collision_check(phrase)
+            peak = peak_speed(phrase)
+            if peak < 1:
+                raise ValueError("No usable movement in this take")
+            maximum = min(MAX_RATE, info["max_velocity_units_s"] * SPEED_FRACTION * (1 - RAMP_FRACTION) / peak)
+            actions.append({"name": path.stem, "role": role, "plan": phrase, "window": window,
+                            "max_speed": maximum, "peak_speed": peak, "sha256": hashlib.sha256(raw_bytes).hexdigest()})
+        except (ValueError, OSError) as error:
+            rejected.append({"name": path.stem, "reason": str(error)})
+    if not actions:
+        raise ValueError("No valid saved teaching actions are available")
+    return actions, rejected
+
+
+def compile_dance(song_id, actions, neutral, info, *, bpm=None, beats=None, variation=0, fps=30, collision_check=lambda p: p):
+    song = song_by_id(song_id)
+    if not song:
+        raise ValueError("Unknown dance song")
+    if type(variation) is not int or not 0 <= variation <= 999:
+        raise ValueError("Variation must be an integer from 0 to 999")
+    tempo = number(song["bpm"] if bpm is None else bpm, "tempo")
+    grid = beat_grid(tempo, beats)
+    target = validate_positions(neutral["positions"], info["joints"], complete=True)
+    budget = info["max_velocity_units_s"] * SPEED_FRACTION
+    if not math.isfinite(budget) or budget <= 0:
+        raise ValueError("Calibrated velocity limit is unavailable")
+    pieces, cues, cursor, previous = [], [], 0, None
+    order = song["order"]
+    # All source poses are absolute calibrated positions. No mirror, amplitude
+    # expansion, or unvalidated overlay is applied to the taught vocabulary.
+    for phrase_index in range(8):
+        preferred = order[(phrase_index + variation) % len(order)]
+        ranked = sorted(actions, key=lambda a: (a["name"] == previous, a["role"] != preferred,
+                                                a["role"] not in order, a["name"]))
+        preferred_takes = [a for a in ranked if a["role"] == preferred and a["name"] != previous]
+        if preferred_takes:
+            chosen = preferred_takes[-1 - (variation + phrase_index) % len(preferred_takes)]
+            ranked.remove(chosen)
+            ranked.insert(0, chosen)
+        selected = None
+        for action in ranked:
+            raw = action["plan"]
+            entry = target_plan(target, raw.waypoints[0].positions, info["joints"], budget, fps)
+            leave = target_plan(raw.waypoints[-1].positions, target, info["joints"], budget, fps)
+            rate_cap = min(action["max_speed"], budget * (1 - RAMP_FRACTION) / peak_speed(raw))
+            wanted_rate = min(rate_cap, song["pace"] * (1 + .07 * ((phrase_index + variation) % 3 - 1)))
+            # Phrase boundaries align with actual supplied beats, including 5/4.
+            entry_end = next((i for i in range(cursor + 1, len(grid)) if grid[i] - grid[cursor] >= entry.duration_ms / 1000), len(grid))
+            end = cursor + song["meter"]
+            leave_start = cursor
+            while end < len(grid):
+                leave_start = next((i for i in range(end - 1, cursor, -1) if grid[end] - grid[i] >= leave.duration_ms / 1000), cursor)
+                if entry_end < leave_start and grid[leave_start] - grid[entry_end] >= raw.duration_ms / (1000 * wanted_rate) - 1e-6:
+                    break
+                end += song["meter"]
+            if end >= len(grid):
+                continue
+            entry = stretch_connector(entry, grid[entry_end] - grid[cursor], fps)
+            leave = stretch_connector(leave, grid[end] - grid[leave_start], fps)
+            timed, speed = retime(raw, grid[leave_start] - grid[entry_end], info, fps)
+            block = join_plans(entry, timed, leave)
+            try:
+                collision_check(block)
+            except ValueError:
+                continue
+            selected = (action, block, speed, end, entry, leave)
+            break
+        if selected is None:
+            break
+        action, block, speed, end, entry, leave = selected
+        cues.append({"name": action["name"], "role": action["role"], "start": grid[cursor], "end": grid[end],
+                     "action_start": grid[cursor] + entry.duration_ms / 1000,
+                     "action_end": grid[end] - leave.duration_ms / 1000,
+                     "beats": end - cursor, "speed": speed, "max_speed": action["max_speed"],
+                     "source_window": list(action["window"]), "source_sha256": action["sha256"]})
+        pieces.append(block)
+        cursor, previous = end, action["name"]
+    if len(cues) < 2 or len({cue["name"] for cue in cues}) < 2:
+        raise ValueError("Need at least two distinct usable actions that safely fit this excerpt")
+    remaining = DURATION - grid[cursor]
+    if remaining > 1e-6:
+        pieces.append(MotionPlan(waypoints=[Waypoint(positions=dict(target), timestamp_ms=0),
+                                           Waypoint(positions=dict(target), timestamp_ms=remaining * 1000)], duration_ms=remaining * 1000))
+    plan = join_plans(*pieces, metadata={"source": "taught_dance", "song_id": song_id,
+                                        "strict_max_velocity": budget, "strict_timing_lag_ms": 180})
+    validate_plan(plan, info["joints"], budget)
+    collision_check(plan)
+    report = {"song": song, "bpm": tempo, "meter": song["meter"], "duration": DURATION, "beats": grid,
+              "beat_source": "analyzed_audio" if beats is not None else "preset_grid",
+              "variation": variation, "cues": cues, "peak_speed": peak_speed(plan), "speed_budget": budget,
+              "motor_velocity_limit": info["max_velocity_units_s"], "idle_enabled": False,
+              "frames": len(plan.waypoints), "neutral_hold_seconds": remaining,
+              "preview": [{"t": f.timestamp_ms / 1000, "positions": f.positions} for f in plan.waypoints[::max(1, len(plan.waypoints) // 120)]]}
+    return plan, report
