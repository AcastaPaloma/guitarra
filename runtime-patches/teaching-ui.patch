+"""Capture persistence and faithful replay, with no hardware access."""
+import asyncio
+import csv
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from flask import Flask, jsonify
+import pytest
+
+from apps.robot_runtime.web.routes.recording import register_recording_routes
+from apps.robot_runtime.web.legacy_routes.animations import register_animation_routes
+from modules.robot_base.control.runtime import MotionController
+from modules.robot_base.control.safety_filter import MotionSafetyFilter
+from modules.robot_base.motion.animation_library import FileAnimationLibrary
+from modules.robot_base.robots.backends.feetech.driver import FeetechBusController
+from modules.robot_base.control.teaching import load_neutral, save_neutral, NEUTRAL_FILE
+
+JOINTS = ("base_yaw", "base_pitch", "elbow_pitch", "wrist_roll", "wrist_pitch")
+
+
+def fixture(directory, *, recording=True, release_ok=True):
+    calls = []
+
+    async def torque(enabled, **kwargs):
+        calls.append(enabled)
+        return {"ok": True, "result": {"success": release_ok}}
+
+    frames = [(10.0, dict.fromkeys(JOINTS, 0.0)), (10.071, dict.fromkeys(JOINTS, 1.0)),
+              (10.205, dict.fromkeys(JOINTS, 0.5))]
+    server = SimpleNamespace(
+        app=Flask(__name__), motion=object(), _recording=recording,
+        _recording_thread=None, _recording_name="teach_nod_t01",
+        _recording_frames=frames if recording else [],
+        _recording_animations_dir=lambda: directory,
+        _recording_csv_config=lambda frames: {"timestamp_field": "timestamp", "position_fields": list(JOINTS),
+                                             "position_suffix": ".pos", "relative_timestamps": False},
+        _run_async=lambda coro, **kwargs: asyncio.run(coro),
+        _request_torque_lifecycle=torque,
+        _request_behavior_stop_lifecycle=AsyncMock(return_value={"ok": True, "result": {"success": True}}),
+        _event_failure_reason=lambda result: None if result.get("success") else "release failed",
+        _event_lifecycle_error_response=lambda result: (jsonify({"error": "unavailable"}), 503),
+        _event_lifecycle_ids=lambda result: {}, _record_loop=lambda: None, task_supervisor=None,
+    )
+    register_recording_routes(server)
+    return server, calls
+
+
+def test_save_preserves_positions_and_irregular_timing_and_never_powers_motors(tmp_path):
+    server, torque = fixture(tmp_path)
+    original = list(server._recording_frames)
+    client = server.app.test_client()
+    result = client.post('/api/recording/stop', json={"restore_torque": False})
+    assert result.status_code == 200
+    assert result.json['duration'] == .205
+    assert torque == []
+    with (tmp_path / 'teach_nod_t01.csv').open() as handle:
+        rows = list(csv.DictReader(handle))
+    for row, (timestamp, positions) in zip(rows, original):
+        assert float(row['timestamp']) == timestamp
+        assert {joint: float(row[f'{joint}.pos']) for joint in JOINTS} == positions
+    # A lost response is recoverable without restoring torque, even for a legacy retry.
+    assert client.post('/api/recording/stop', json={}).json == result.json
+    assert torque == []
+    restarted, _ = fixture(tmp_path, recording=False)
+    take = restarted.app.test_client().get('/api/recording/takes').json['takes'][0]
+    assert take['name'] == 'teach_nod_t01' and take['valid'] and take['duration'] == .205
+
+
+@pytest.mark.parametrize('name', ['../escape', 'Bad Name', 'nod.csv', '', None, 'x' * 101])
