@@ -0,0 +1,17 @@
+export function gestureSlug(label: string): string {
+  return label.toLowerCase().trim().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 70).replace(/_+$/g, '');
+}
+
+export function nextTakeName(label: string, names: string[]): string {
+  const slug = gestureSlug(label);
+  if (!slug) return '';
+  const prefix = `teach_${slug}_t`;
+  const used = new Set(names);
+  let number = 1;
+  while (used.has(`${prefix}${String(number).padStart(2, '0')}`)) number += 1;
+  return `${prefix}${String(number).padStart(2, '0')}`;
+}
+
+export function takeLabel(name: string): string {
+  return name.replace(/^teach_/, '').replace(/_t(\d+)$/, ' · take $1').replace(/_/g, ' ');
+}
