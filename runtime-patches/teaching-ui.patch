diff --git a/apps/robot_runtime/web/routes/dance_lifecycle.py b/apps/robot_runtime/web/routes/dance_lifecycle.py
new file mode 100644
index 0000000..28ba825
--- /dev/null
+++ b/apps/robot_runtime/web/routes/dance_lifecycle.py
@@ -0,0 +1,58 @@
+"""Await a dance result without holding an event-bus subscriber open."""
+import asyncio
+import time
+
+from core.domain.behavior import BehaviorIntent
+MOTION_ACTION_RESULT = 'motion.action.result'
+
+TOTAL_TIMEOUT_SECONDS = 55.0
+
+
+async def execute_dance(server, run, check_cancelled):
+    """Admission is short; correlated completion runs outside the bus handler.
+
+    The bus has a 30 s per-subscriber timeout. A 30 s dance plus neutral entry
+    and count-in cannot be executed synchronously inside that subscriber.
+    """
+    bus = getattr(server, 'event_bus', None)
+    if not callable(getattr(bus, 'subscribe', None)) or not callable(getattr(bus, 'unsubscribe', None)):
+        raise RuntimeError('Dance completion tracking is unavailable')
+    action_id = run['id'] + '_execution'
+    result_future = asyncio.get_running_loop().create_future()
+
+    async def completed(event):
+        data = event.get('data') if isinstance(event.get('data'), dict) else event
+        if data.get('action_id') == action_id and not result_future.done():
+            result_future.set_result(data)
+
+    await bus.subscribe(MOTION_ACTION_RESULT, completed)
+    try:
+        check_cancelled()
+        intent = BehaviorIntent(
+            name='play_dance', source='web_api', category='direct_animation', priority=90,
+            suggested_motion=run['id'], ttl=TOTAL_TIMEOUT_SECONDS,
+            metadata={'action_id': action_id, 'explicit_animation': True, 'motion_action': True,
+                      'requester': 'dashboard', 'async_motion': True})
+        # This only acknowledges admission. It is never taken as completion.
+        async with asyncio.timeout(5):
+            admission = await server._request_behavior_intent_lifecycle(intent, action_id=action_id, timeout=4)
+        failure = server._event_failure_reason(admission.get('result'))
+        if not admission.get('ok') or failure:
+            raise RuntimeError(failure or admission.get('error') or 'Dance admission failed')
+        deadline = time.monotonic() + TOTAL_TIMEOUT_SECONDS
+        while not result_future.done():
+            check_cancelled()
+            if time.monotonic() >= deadline:
+                raise TimeoutError('Dance completion timed out; playback was stopped')
+            await asyncio.wait({result_future}, timeout=.05)
+        result = result_future.result()
+        failure = server._event_failure_reason(result)
+        if failure:
+            if str(result.get('state', '')).upper() in {'CANCELED', 'CANCELLED', 'INTERRUPTED'}:
+                raise asyncio.CancelledError(run.get('error') or 'Dance interrupted')
+            raise RuntimeError(run.get('error') or failure)
+        if str(result.get('state', '')).upper() != 'SUCCEEDED':
+            raise RuntimeError('Dance ended without confirmed completion')
+        check_cancelled()
+    finally:
+        await bus.unsubscribe(MOTION_ACTION_RESULT, completed)
diff --git a/apps/robot_runtime/web/routes/dancing.py b/apps/robot_runtime/web/routes/dancing.py
new file mode 100644
index 0000000..7cb10ea
--- /dev/null
+++ b/apps/robot_runtime/web/routes/dancing.py
@@ -0,0 +1,165 @@
+"""Dance catalog and two-step preview/start through authenticated motion routes."""
+import asyncio
+import math
+import threading
+import time
+
+from flask import jsonify
+from core.events.topics import MOTION_TORQUE_COMMAND, MOTION_TORQUE_RESULT
+from .dance_lifecycle import execute_dance
+
+ACTIVE_STATES = {"preparing", "to_neutral", "waiting_audio", "countdown", "playing", "finishing", "stopping"}
+
+
+def public_status(server):
+    run = getattr(server, "_dance_playback", None) or {}
+    motion = server._motion_status() if callable(getattr(server, '_motion_status', None)) else {}
+    return {"version": 3, "server_time": time.time(),
+            "safety_latched": motion.get('is_safe') is False,
+            **{key: run.get(key) for key in ("id", "song_id", "state", "start_at", "ended_at", "error", "audio_ready", "audio_mode", "media_time")}}
+
+
+def register_dance_routes(server):
+    server._dance_lock = threading.RLock()
+    server._dance_playback = None
+
+    @server.app.get('/api/dances')
+    def dance_catalog():
+        if not server.motion:
+            return jsonify({"error": "Motion controller unavailable"}), 503
+        try:
+            return jsonify(server._run_async(server.motion.dance_catalog(), timeout=14))
+        except Exception as error:
+            return jsonify({"error": str(error)}), 409
+
+    @server.app.get('/api/dances/status')
+    def dance_status():
+        return jsonify(public_status(server))
+
+
+def dance_command(server, options):
+    if not isinstance(options, dict):
+        return jsonify({"error": "Dance options must be an object"}), 400
+    operation = options.get("operation")
+    if operation not in {"prepare", "start", "heartbeat", "audio_ready", "youtube_ready"}:
+        return jsonify({"error": "Unknown dance operation"}), 400
+    with server._dance_lock:
+        run = server._dance_playback
+        if operation in {"heartbeat", "audio_ready", "youtube_ready"}:
+            if not run or run["id"] != options.get("id") or run["state"] not in ACTIVE_STATES:
+                return jsonify({"error": "No matching active dance"}), 409
+            if operation == 'youtube_ready':
+                start_at, media_time = options.get('start_at'), options.get('media_time')
+                if (run.get('audio_mode') != 'youtube' or run['state'] != 'waiting_audio' or run.get('audio_ready')
+                        or any(not isinstance(v, (int, float)) or isinstance(v, bool) or not math.isfinite(v)
+                               for v in (start_at, media_time))
+                        or not .75 <= start_at - time.time() <= 8 or not 0 <= media_time <= 86400):
+                    return jsonify({'error': 'YouTube synchronization missed its window; prepare again'}), 409
+                run.update(start_at=start_at, media_time=media_time, audio_ready=True)
+            elif operation == 'audio_ready':
+                start_at = options.get('start_at')
+                if (run.get('audio_mode') == 'youtube' or run['state'] != 'countdown' or not isinstance(start_at, (int, float))
+                        or isinstance(start_at, bool) or not math.isfinite(start_at)
+                        or abs(start_at - (run.get('start_at') or 0)) > .001
+                        or start_at - time.time() < .05):
+                    return jsonify({'error': 'Audio missed the synchronized start; prepare and try again'}), 409
+                run['audio_ready'] = True
+            run["heartbeat"] = time.monotonic()
+            return jsonify(public_status(server))
+        if not server.motion:
+            return jsonify({"error": "Motion controller unavailable"}), 503
+        if server._recording or server._recording_frames:
+            return jsonify({"error": "Save the current take first"}), 409
+        if (run and (run["state"] in ACTIVE_STATES or server._current_animation == run['id'])) or (getattr(server, "_teaching_playback", None) or {}).get("state") in {"preparing", "playing"}:
+            return jsonify({"error": "Stop the current playback first"}), 409
+        try:
+            if operation == "prepare":
+                return jsonify(server._run_async(server.motion.prepare_dance(options), timeout=14))
+            identifier = options.get("id")
+            if not isinstance(identifier, str):
+                raise ValueError("Prepare a dance first")
+            record = server.motion._dance_record(identifier)
+            status = server._motion_status()
+            if status.get('is_safe') is False:
+                raise ValueError('Emergency stop is latched. Inspect/support the lamp and clear it explicitly in Controls before dancing')
+            if status.get("is_moving") or status.get("current_idle"):
+                raise ValueError("Stop playback and clear idle before dancing")
+            if type(status.get("torque_enabled")) is not bool:
+                raise ValueError("Motor power state is unavailable")
+            audio_mode = options.get('audio_mode')
+            if audio_mode not in {'laptop_beat', 'laptop_file', 'youtube'}:
+                raise ValueError('Choose laptop audio and refresh the dashboard before starting')
+            run = {"id": identifier, "song_id": record["report"]["song"]["id"], "state": "preparing",
+                   "start_at": None, "error": None, "heartbeat": time.monotonic(), "cancelled": False,
+                   'audio_mode': audio_mode, 'audio_ready': False}
+            cancel = threading.Event()
+            server._teaching_cancel = cancel
+            server._dance_playback = run
+            record["run"] = run
+            server._current_animation = identifier
+            server._animation_started_at = time.time()
+
+            def check_cancelled():
+                if cancel.is_set() or run["cancelled"]:
+                    raise asyncio.CancelledError("Dance stopped")
+                if time.monotonic() - run["heartbeat"] > 4:
+                    raise RuntimeError("Dance stopped: laptop connection lost")
+
+            async def play():
+                try:
+                    # Invalid entry geometry cannot restore motor power.
+                    await server.motion.validate_dance_entry(identifier)
+                    check_cancelled()
+                    if server._motion_status().get("torque_enabled") is False:
+                        torque = await server._publish_lifecycle_request(
+                            MOTION_TORQUE_COMMAND,
+                            data={"operation": "enable", "enabled": True, "hold_present": True, "reason": "dance"},
+                            id_field="request_id", id_prefix="torque", result_topics=(MOTION_TORQUE_RESULT,), timeout=2)
+                        failure = server._event_failure_reason(torque.get("result"))
+                        if not torque.get("ok") or failure:
+                            raise RuntimeError(failure or "Could not enable motor holding")
+                    check_cancelled()
+                    await execute_dance(server, run, check_cancelled)
+                    check_cancelled()
+                    run["state"] = "completed"
+                except asyncio.CancelledError:
+                    run["state"] = "failed" if run["error"] else "stopped"
+                except Exception as error:
+                    run["state"] = "stopped" if cancel.is_set() and not run.get('error') else "failed"
+                    if not cancel.is_set():
+                        run["error"] = str(error) or 'Dance execution was interrupted'
+                finally:
+                    # A missing lifecycle result must never leave motors running
+                    # or a stale "playing" state until the next user command.
+                    if run['state'] != 'completed':
+                        terminal_state = run['state']
+                        run['cancelled'] = True
+                        run['state'] = 'stopping'
+                        if server._current_animation == identifier:
+                            try:
+                                async with asyncio.timeout(4):
+                                    stopped = await server._request_behavior_stop_lifecycle(reason='dance_cleanup')
+                                failure = server._event_failure_reason(stopped.get('result'))
+                                if not stopped.get('ok') or failure:
+                                    raise RuntimeError(failure or stopped.get('error') or 'Stop acknowledgment missing')
+                            except Exception as error:
+                                run['error'] = '; '.join(filter(None, [run.get('error'), f'Dance stop acknowledgment failed: {error}']))
+                                terminal_state = 'failed'
+                                # Cancellation only: never enable power, home,
+                                # or clear the safety latch as a recovery step.
+                                try:
+                                    async with asyncio.timeout(2):
+                                        await server.motion.stop_all()
+                                except Exception as stop_error:
+                                    run['error'] += f'; Controller stop unconfirmed: {stop_error or type(stop_error).__name__}'
+                        run['state'] = terminal_state
+                    run['ended_at'] = time.time()
+                    server.motion._dance_prepared.pop(identifier, None)
+                    if server._current_animation == identifier:
+                        server._current_animation = None
+                        server._animation_started_at = None
+
+            server._fire_and_forget(play())
+            return jsonify(public_status(server))
+        except (ValueError, RuntimeError, OSError) as error:
+            return jsonify({"error": str(error)}), 409
