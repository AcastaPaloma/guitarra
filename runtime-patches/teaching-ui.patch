+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { nextTakeName, takeLabel } from '../src/utils/teaching.ts';
+import { dashboardApi, pairDashboard } from '../src/api/dashboardClient.ts';
+
+test('take numbering preserves old takes and produces valid names', () => {
+  assert.equal(nextTakeName('Head tilt!', []), 'teach_head_tilt_t01');
+  assert.equal(nextTakeName('Nod', ['teach_nod_t01', 'teach_nod_t02']), 'teach_nod_t03');
+  assert.equal(nextTakeName('../Nod', ['teach_nod_t01']), 'teach_nod_t02');
+  assert.equal(nextTakeName('!!!', []), '');
+  assert.ok(nextTakeName('a'.repeat(200), []).length <= 100);
+  assert.equal(takeLabel('teach_head_tilt_t02'), 'head tilt · take 02');
+});
+
+test('Save cannot request motor activation and bank replay uses faithful teaching mode', async () => {
+  const requests = [];
+  globalThis.fetch = async (path, init = {}) => {
+    requests.push({ path, init });
+    return new Response(JSON.stringify(path === '/api/auth/pair'
+      ? { authenticated: true, csrf_token: 'test-token' } : {}), { status: 200 });
+  };
+  await pairDashboard('test-pairing');
+  await dashboardApi.saveRecording();
+  await dashboardApi.replayTake('teach_nod_t03');
+  await dashboardApi.saveTeachingNeutral();
+  await dashboardApi.goToTeachingNeutral();
+  const save = requests.find(({ path }) => path === '/api/recording/stop');
+  assert.deepEqual(JSON.parse(save.init.body), { restore_torque: false });
+  assert.equal(save.init.headers['X-LeLamp-CSRF'], 'test-token');
+  const replay = requests.find(({ path }) => path === '/api/animations/play');
+  assert.deepEqual(JSON.parse(replay.init.body), { name: 'teach_nod_t03', teaching: true });
+  const neutral = requests.filter(({ path }) => path === '/api/recording/stop')[1];
+  assert.deepEqual(JSON.parse(neutral.init.body), { operation: 'save_neutral', restore_torque: false });
+  const go = requests.filter(({ path }) => path === '/api/animations/play')[1];
+  assert.deepEqual(JSON.parse(go.init.body), { name: 'teaching_neutral', teaching: true });
+});
