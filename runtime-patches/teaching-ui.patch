+/* Actual React interactions; all device APIs and audio are simulated. */
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { JSDOM } = require(process.argv[2]);
+const frontend = path.resolve(__dirname, '../apps/dashboard/frontend');
+const { buildSync } = require(path.join(frontend, 'node_modules/esbuild'));
+const songs = require('../static/dances/catalog.json');
+const legacyStatus = Number(process.env.LEGACY_DANCE_STATUS || 405);
+const dom = new JSDOM('<!doctype html><div id="root"></div>', {
+  url: 'http://dance.test', runScripts: 'dangerously', pretendToBeVisual: true,
+});
+const w = dom.window;
+const state = { requests: [], status: { id: null, state: null, song_id: null, start_at: null, error: null }, audioStarts: 0, audioStops: 0, oldBackend: false, failPrepare: false, warming: 0 };
+const audioNode = () => ({
+  gain: { value: 0, setValueAtTime() {}, exponentialRampToValueAtTime() {} }, frequency: {},
+  connect() {}, disconnect() {}, start() { state.audioStarts++; }, stop() { state.audioStops++; },
+});
+w.AudioContext = class {
+  constructor() { this.state = 'running'; this.currentTime = 0; this.destination = {}; }
+  async resume() {} async close() { this.state = 'closed'; }
+  createGain() { return audioNode(); } createOscillator() { return audioNode(); }
+};
+const report = (id, variation = 0) => ({ song: songs.find(s => s.id === id), bpm: 148, meter: 4, duration: 30,
+  beats: [0, .5, 1, 1.5, 2], variation, peak_speed: 100, speed_budget: 195, motor_velocity_limit: 300,
+  cues: [{ name: 'teach_nod_t02', role: 'nod', start: 0, end: 12, speed: .8, max_speed: 1.1, source_window: [1, 4], beats: 16 }],
+  preview: [{ t: 0, positions: { base_yaw: 0 } }, { t: 30, positions: { base_yaw: 0 } }],
+});
+w.fetch = async (url, init = {}) => {
+  const data = init.body ? JSON.parse(init.body) : {};
+  state.requests.push({ url, data });
+  let result = {};
+  if (url === '/api/auth/session') result = { authenticated: true, csrf_token: 'test' };
+  if (url === '/api/dances') {
+    if (state.oldBackend) return new Response(`<!doctype html><html lang=en><title>${legacyStatus} Method Not Allowed</title></html>`, { status: legacyStatus });
+    if (state.warming > 0) { state.warming--; return new Response(JSON.stringify({ error: 'Main program is not running' }), { status: 503 }); }
+    result = { version: state.backendVersion || 3, songs, neutral_valid: true, safety_latched: false, actions: [{ name: 'teach_nod_t02' }] };
+  }
+  if (url === '/api/dances/status') {
+    result = { ...state.status, server_time: Date.now() / 1000 };
+    if (state.delayNextStatus) {
+      state.delayNextStatus = false;
+      await new Promise(resolve => { state.releaseStaleStatus = resolve; });
+    }
+  }
+  if (url === '/api/animations/play') {
+    assert.ok(data.dance, 'must use the explicit dance operation');
+    if (data.dance.operation === 'prepare') {
+      if (state.failPrepare) return new Response(JSON.stringify({ error: 'Blocked transition' }), { status: 409 });
+      result = { id: 'dance_preview', report: report(data.dance.song_id, data.dance.variation), expires_in: 180 };
+    }
+    if (data.dance.operation === 'start') {
+      assert.equal(data.dance.audio_mode, 'laptop_beat');
+      state.status = { id: data.dance.id, song_id: 'waterloo', state: 'countdown', start_at: Date.now() / 1000 + 2.5 };
+      result = { ...state.status, server_time: Date.now() / 1000 };
+    }
+    if (data.dance.operation === 'heartbeat') result = { ...state.status, server_time: Date.now() / 1000 };
+    if (data.dance.operation === 'audio_ready') {
+      if (state.rejectAudio) return new Response(JSON.stringify({ error: 'Audio missed the synchronized start' }), { status: 409 });
+      assert.equal(data.dance.start_at, state.status.start_at);
+      result = { ...state.status, audio_ready: true, server_time: Date.now() / 1000 };
+    }
+  }
+  if (url === '/api/audio/output-devices') result = { available: true, devices: [{ id: 'auto_null', name: 'Dummy Output', connected: true, selected: true }] };
+  if (url === '/api/animations/stop') state.status = { ...state.status, state: 'stopped' };
+  if (url === '/api/program/status') result = { running: true };
+  if (url === '/api/program/start') { state.oldBackend = false; state.warming = 1; }
+  return new Response(JSON.stringify(result));
+};
+const bundle = buildSync({ stdin: { resolveDir: frontend, loader: 'tsx', contents: `
+  import React from 'react';
+  import { createRoot } from 'react-dom/client';
+  import { DancingView } from './src/views/DancingView';
+  let root;
+  window.mountDance = () => { root = createRoot(document.getElementById('root')); root.render(<DancingView programRunning={true}/>); };
+  window.unmountDance = () => root.unmount();
+  window.mountDance();
+` }, bundle: true, format: 'iife', write: false, define: { 'process.env.NODE_ENV': '"production"' } });
+w.eval(bundle.outputFiles[0].text);
+const button = text => [...w.document.querySelectorAll('button')].find(b => b.textContent.trim() === text);
+const click = text => { const b = button(text); assert.ok(b && !b.disabled, `${text} enabled`); b.click(); };
+const operations = name => state.requests.filter(r => r.data.dance?.operation === name);
+async function until(predicate) {
+  for (let i = 0; i < 300; i++) {
+    const matched = predicate(); await new Promise(r => setTimeout(r, 20));
+    if (matched && predicate()) return;
+  }
+  throw new Error(`UI timeout: ${w.document.body.textContent}`);
+}
+(async () => {
+  try {
+    await until(() => button('Prepare dance') && !button('Prepare dance').disabled);
+    const soundtrack = w.document.querySelector('[aria-label="Soundtrack source"]');
+    soundtrack.value = 'local'; soundtrack.dispatchEvent(new w.Event('change', { bubbles: true }));
+    await until(() => !w.document.querySelector('[aria-label="YouTube soundtrack"]'));
+    assert.equal(w.document.querySelectorAll('.dance-record').length, 5);
+    assert.equal(button('Start 30s dance').disabled, true);
+    click('Test laptop audio');
+    await until(() => state.audioStarts > 0 && !button('Prepare dance').disabled);
+    assert.equal(operations('start').length, 0, 'audio test never starts motors');
+    assert.ok(w.document.body.textContent.includes('No lamp speaker detected'));
+    click('Prepare dance');
+    await until(() => !button('Start 30s dance').disabled);
+    // The real backend returns explicit nulls before any run, not undefined.
+    // A preview must survive multiple status polls before the operator starts.
+    await new Promise(r => setTimeout(r, 1300));
+    assert.equal(button('Start 30s dance').disabled, false, 'idle null status must not erase the prepared dance');
+    assert.ok(w.document.querySelector('[aria-label="30-second choreography"]'));
+    assert.ok(w.document.body.textContent.includes('Ready to dance'));
+    assert.equal(operations('start').length, 0, 'preparing never starts movement');
+    click('Hear audio only');
+    await until(() => state.audioStarts > 0 && button('Stop audio preview'));
+    assert.equal(operations('start').length, 0, 'audio preview never moves motors');
+    click('Stop audio preview');
+    await until(() => button('Hear audio only'));
+    w.document.querySelector('[aria-label="Remix choreography"]').click();
+    await until(() => operations('prepare').length === 2 && !button('Start 30s dance').disabled);
+    assert.equal(operations('prepare').at(-1).data.dance.variation, 1);
+    const before = state.audioStarts;
+    state.delayNextStatus = true;
+    await until(() => Boolean(state.releaseStaleStatus));
+    click('Start 30s dance');
+    await until(() => state.status.state === 'countdown');
+    state.releaseStaleStatus();
+    await until(() => operations('heartbeat').length > 0 && state.audioStarts > before);
+    assert.equal(operations('audio_ready').length, 1);
+    assert.equal(button('Start 30s dance').disabled, true);
+    assert.equal(button('Prepare dance').disabled, true);
+    assert.ok([...w.document.querySelectorAll('.dance-record')].every(b => b.disabled));
+    state.status = { ...state.status, state: 'completed', ended_at: Date.now() / 1000 };
+    await until(() => w.document.body.textContent.includes('Complete · back at neutral') && !button('Prepare dance').disabled);
+    assert.equal(button('Start 30s dance').disabled, true);
+    assert.equal(w.document.querySelector('.dance-vinyl.spinning'), null);
+    click('Prepare dance');
+    await until(() => !button('Start 30s dance').disabled);
+    click('Start 30s dance');
+    await until(() => state.status.state === 'countdown' && !button('Stop').disabled);
+    click('Stop');
+    await until(() => state.status.state === 'stopped' && !button('Prepare dance').disabled);
+    assert.ok(state.audioStops > 0);
+    click('Prepare dance');
+    await until(() => !button('Start 30s dance').disabled);
+    click('Start 30s dance');
+    await until(() => state.status.state === 'countdown');
+    state.status = { ...state.status, state: 'failed', error: 'Simulated motor write failure' };
+    await until(() => w.document.body.textContent.includes('Dance failed') && !button('Prepare dance').disabled);
+    assert.ok(w.document.body.textContent.includes('Simulated motor write failure'));
+    assert.equal(button('Start 30s dance').disabled, true);
+    click('Prepare dance');
+    await until(() => !button('Start 30s dance').disabled);
+    state.rejectAudio = true;
+    click('Start 30s dance');
+    await until(() => w.document.body.textContent.includes('Audio missed the synchronized start') && !button('Prepare dance').disabled);
+    assert.equal(state.status.state, 'stopped', 'failed audio readiness cancels motor playback');
+    state.rejectAudio = false;
+    click('Prepare dance');
+    await until(() => !button('Start 30s dance').disabled);
+    click('Start 30s dance');
+    await until(() => state.status.state === 'countdown');
+    w.unmountDance();
+    await until(() => state.status.state === 'stopped');
+    state.oldBackend = true;
+    w.mountDance();
+    await until(() => button('Load dance update'));
+    assert.equal(button('Start 30s dance').disabled, true);
+    assert.equal(w.document.body.textContent.includes('<!doctype'), false);
+    assert.equal(button('Prepare dance').disabled, true);
+    w.confirm = () => false;
+    click('Load dance update');
+    assert.equal(state.requests.some(r => r.url === '/api/program/stop'), false);
+    const dancesBeforeRestart = operations('start').length;
+    w.confirm = () => true;
+    click('Load dance update');
+    await until(() => !button('Prepare dance').disabled && !button('Load dance update'));
+    assert.equal(state.requests.filter(r => r.url === '/api/program/stop').length, 1);
+    assert.equal(state.requests.filter(r => r.url === '/api/program/start').length, 1);
+    assert.equal(operations('start').length, dancesBeforeRestart, 'updating never starts a dance');
+    assert.equal(button('Start 30s dance').disabled, true, 'still requires a fresh preview');
+    assert.equal(w.document.querySelector('[role="alert"]'), null);
+    state.status = { ...state.status, safety_latched: true };
+    await until(() => w.document.body.textContent.includes('Emergency stop is latched'));
+    assert.equal(button('Prepare dance').disabled, true);
+    assert.equal(button('Start 30s dance').disabled, true);
+    assert.equal(state.requests.some(r => /emergency.*clear|safety.*reset/.test(r.url)), false);
+    w.unmountDance();
+    state.backendVersion = 1;
+    w.mountDance();
+    await until(() => button('Load dance update'));
+    assert.equal(button('Start 30s dance').disabled, true, 'old synchronous backend cannot start new dances');
+    console.log(`PASS: prepare persistence, audio-only test, audio-ready failure, completion/error exit mode, Stop, safety, legacy ${legacyStatus}/v1 gates and restart readiness. No hardware requests.`);
+  } finally { w.close(); }
+})().catch(error => { console.error(error); process.exitCode = 1; });
