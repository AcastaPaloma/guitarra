+"""Single-owner dance admission, neutral entry, synchronized start, and lease."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import time
+import uuid
+
+from .dance import SONGS, compile_dance, load_actions
+from .safe_motion import target_plan, validate_plan, validate_positions
+from .teaching import join_plans
+
+COUNTDOWN_SECONDS = 2.5
+LEASE_SECONDS = 4.0
+YOUTUBE_WAIT_SECONDS = 8.0
+
+
+class DanceControllerMixin:
+    async def dance_catalog(self):
+        info = self.safe_motion_info()
+        result = {"version": 3, "songs": SONGS, "duration": 30, "actions": [], "neutral_valid": False,
+                  "safety_latched": not self._safety.is_safe,
+                  "motor_velocity_limit": info["max_velocity_units_s"]}
+        try:
+            result["neutral_valid"] = self.teaching_neutral() is not None
+            actions, rejected = await asyncio.to_thread(load_actions, self.recording_animations_dir(), info, self._validate_self_collision)
+            result["actions"] = [{key: value for key, value in a.items() if key != "plan"} for a in actions]
+            result["rejected"] = rejected
+        except (ValueError, OSError) as error:
+            result["error"] = str(error)
+        return result
+
+    async def prepare_dance(self, options):
+        neutral = self.teaching_neutral()
+        if neutral is None:
+            raise ValueError("Save a neutral standing pose in Teach first")
+        info = self.safe_motion_info()
+        actions, rejected = await asyncio.to_thread(load_actions, self.recording_animations_dir(), info, self._validate_self_collision)
+        plan, report = await asyncio.to_thread(
+            compile_dance, options.get("song_id"), actions, neutral, info,
+            bpm=options.get("bpm"), beats=options.get("beats"), variation=options.get("variation", 0), fps=self.fps,
+            collision_check=self._validate_self_collision)
+        if info["calibration_id"] != self.safe_motion_info()["calibration_id"] or neutral != self.teaching_neutral():
+            raise ValueError("Calibration or neutral changed during preparation; prepare again")
+        plan.metadata["neutral_checkpoints_ms"] = [cue["end"] * 1000 for cue in report["cues"]]
+        plan.metadata["neutral_positions"] = dict(neutral["positions"])
+        plan.metadata["neutral_tolerances"] = self._position_tolerances(neutral["positions"], float(info.get("target_tolerance") or 0))
+        self._dance_prepared = {key: value for key, value in self._dance_prepared.items()
+                                if value["expires"] > time.monotonic() or value.get("run")}
+        if len(self._dance_prepared) >= 5:
+            removable = next((key for key, value in self._dance_prepared.items() if not value.get("run")), None)
+            if removable:
+                self._dance_prepared.pop(removable)
+            else:
+                raise ValueError("A dance is already active")
+        identifier = "dance_" + uuid.uuid4().hex
+        self._dance_prepared[identifier] = {"plan": plan, "report": report, "neutral": neutral,
+                                            "info": info, "expires": time.monotonic() + 180, "run": None}
+        return {"id": identifier, "report": {**report, "rejected": rejected}, "expires_in": 180}
+
+    def _dance_record(self, identifier):
+        record = self._dance_prepared.get(identifier)
+        if record is None or (not record.get("run") and record["expires"] <= time.monotonic()):
+            raise ValueError("Dance preview expired; prepare it again")
+        if record["info"]["calibration_id"] != self.safe_motion_info()["calibration_id"] or record["neutral"] != self.teaching_neutral():
+            raise ValueError("Neutral or calibration changed; prepare the dance again")
+        for cue in record["report"]["cues"]:
+            path = self.recording_animations_dir() / (cue["name"] + ".csv")
+            if hashlib.sha256(path.read_bytes()).hexdigest() != cue["source_sha256"]:
+                raise ValueError("A saved action changed; prepare the dance again")
+        return record
+
+    async def validate_dance_entry(self, identifier):
+        record = self._dance_record(identifier)
+        if not self._connected or not self._safety.is_safe or (self._queue and self._queue.idle_animation):
+            raise ValueError("Dance requires connected motors, cleared idle, and no safety stop")
+        info = record["info"]
+        self._position_tolerances(record["neutral"]["positions"], float(info.get("target_tolerance") or 0))
+        current = await self.read_positions()
+        entry = target_plan(current, record["neutral"]["positions"], info["joints"], info["max_velocity_units_s"], self.fps)
+        full = join_plans(entry, record["plan"])
+        validate_plan(full, info["joints"], info["max_velocity_units_s"])
+        await asyncio.to_thread(self._validate_self_collision, full)
+        return entry, record
+
+    async def _play_dance(self, identifier):
+        record = self._dance_record(identifier)
+        run = record.get("run")
+        if run is None:
+            raise ValueError("Dance must be started from its prepared preview")
+        self._foreground_generation += 1
+        generation = self._foreground_generation
+        calibration = record["info"]["calibration_id"]
+        lease_seconds = min(LEASE_SECONDS, 2.0) if run.get('audio_mode') == 'youtube' else LEASE_SECONDS
+        if self._queue:
+            self._queue.pause_idle()
+
+        def guard():
+            self._check_teaching_generation(generation, calibration)
+            if run.get("cancelled"):
+                raise asyncio.CancelledError("Dance stopped")
+            if time.monotonic() - run["heartbeat"] > lease_seconds:
+                raise RuntimeError("Dance stopped: laptop connection lost")
+
+        async def watchdog():
+            while True:
+                await asyncio.sleep(.1)
+                if run.get('cancelled'):
+                    await self.stop_all()
+                    return
+                if time.monotonic() - run["heartbeat"] > lease_seconds:
+                    run["error"] = "Dance stopped: laptop connection lost"
+                    run["cancelled"] = True
+                    await self.stop_all()
+                    return
+
+        async def countdown():
+            guard()
+            if run.get('audio_mode') == 'youtube':
+                # Video is already playing. Join a future bar on its observed
+                # clock only after the robot has reached neutral.
+                run['state'] = 'waiting_audio'
+                timeout = time.monotonic() + YOUTUBE_WAIT_SECONDS
+                while not run.get('audio_ready'):
+                    guard()
+                    if time.monotonic() >= timeout:
+                        raise ValueError('YouTube synchronization was not received; dance stopped')
+                    await asyncio.sleep(.025)
+                delay = run['start_at'] - time.time()
+                if delay < .5:
+                    raise ValueError('YouTube synchronized start was missed; dance stopped')
+            else:
+                delay = COUNTDOWN_SECONDS
+                run["start_at"] = time.time() + delay
+            run["state"] = "countdown"
+            deadline = time.monotonic() + delay
+            while time.monotonic() < deadline:
+                guard()
+                await asyncio.sleep(min(.025, max(0, deadline - time.monotonic())))
+            if run.get('audio_ready') is not True:
+                raise ValueError('Laptop audio was not armed before the count-in ended; dance stopped')
+            # No surprise jump if the supported arm drifted during the count-in.
+            measured = validate_positions(await self.read_positions(), record["info"]["joints"], complete=True)
+            target = record["neutral"]["positions"]
+            if any(abs(measured[j] - target[j]) * self.fps > record["info"]["max_velocity_units_s"] for j in target):
+                raise ValueError("The lamp drifted during count-in; stopped before dancing")
+            guard()
+            run["state"] = "playing"
+
+        watch = asyncio.create_task(watchdog())
+        try:
+            entry, _ = await self.validate_dance_entry(identifier)
+            guard()
+            run["state"] = "to_neutral"
+            await self._submit_direct(entry, transmit_live_baseline=False, before_execute=guard)
+            guard()
+            await self._wait_for_teaching_neutral(record["neutral"]["positions"], generation, calibration)
+            guard()
+            await self._submit_direct(record["plan"], transmit_live_baseline=False, before_execute=guard, on_ready=countdown)
+            guard()
+            run['state'] = 'finishing'
+            await self._wait_for_teaching_neutral(record["neutral"]["positions"], generation, calibration)
+            guard()
+            run['state'] = 'completed'
+        except asyncio.CancelledError:
+            run['state'] = 'failed' if run.get('error') else 'stopped'
+            raise
+        except Exception as error:
+            run['state'] = 'failed'
+            run['error'] = str(error) or 'Dance interrupted'
+            raise
+        finally:
+            run['ended_at'] = time.time()
+            watch.cancel()
+            await asyncio.gather(watch, return_exceptions=True)
+            self._dance_prepared.pop(identifier, None)
