@@ -0,0 +1,87 @@
+.dance-view { max-width: 1260px; margin: 0 auto; padding: 16px 8px 30px; --dance-accent: #f5b455; }
+.dance-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
+.dance-eyebrow, .dance-section-label { font-size: 10px; font-weight: 650; letter-spacing: .16em; color: var(--muted); }
+.dance-heading h1 { font-size: clamp(28px, 3.5vw, 42px); letter-spacing: -.045em; margin: 10px 0 7px; }
+.dance-heading p { color: var(--muted); font-size: 14px; margin: 0; }
+.dance-live { display: flex; align-items: center; gap: 8px; font-size: 12px; border: 1px solid var(--line); padding: 10px 14px; border-radius: 30px; white-space: nowrap; }
+.dance-live > span { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
+.dance-live.active > span { background: var(--dance-accent); box-shadow: 0 0 13px var(--dance-accent); }
+.dance-layout { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 24px; }
+.dance-section-label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 17px; }
+.dance-section-label > span { letter-spacing: 0; color: var(--soft); font-weight: 400; }
+.dance-records { padding-top: 16px; }
+.dance-record { display: flex; align-items: center; gap: 13px; width: 100%; padding: 13px; margin-bottom: 9px; background: transparent; border: 1px solid transparent; border-radius: 12px; color: var(--text); text-align: left; cursor: pointer; }
+.dance-record:hover:not(:disabled) { background: var(--panel); border-color: var(--line); }
+.dance-record.selected { background: var(--panel); border-color: var(--dance-accent); }
+.dance-record:disabled { cursor: default; }
+.dance-sleeve { display: grid; place-items: center; position: relative; flex-shrink: 0; width: 55px; height: 62px; border-radius: 5px; color: #18181c; background: var(--record-color); overflow: hidden; }
+.dance-sleeve:before { content: ''; position: absolute; width: 90px; height: 90px; border: 12px solid #00000016; border-radius: 50%; left: -35px; top: -40px; }
+.dance-sleeve small { position: absolute; bottom: 3px; right: 5px; font-size: 8px; font-weight: 750; }
+.dance-record-title { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
+.dance-record-title strong { font-size: 14px; line-height: 1.2; }
+.dance-record-title > span { font-size: 11px; color: var(--muted); }
+.dance-record-title small { font-size: 10px; color: var(--soft); }
+.dance-record-selected { margin-left: auto; color: var(--dance-accent); }
+.dance-library-note { display: flex; gap: 7px; align-items: center; color: var(--muted); font-size: 11px; padding: 15px 8px; }
+.dance-deck { border: 1px solid var(--line); background: var(--panel); border-radius: 18px; padding: 28px; min-width: 0; }
+.dance-hero { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--line); padding-bottom: 24px; }
+.dance-hero .dance-eyebrow { color: var(--dance-accent); }
+.dance-hero h2 { font-size: clamp(28px, 3vw, 38px); letter-spacing: -.045em; margin: 12px 0 8px; }
+.dance-hero p { font-size: 13px; color: var(--muted); line-height: 1.5; max-width: 300px; margin: 0; }
+.dance-vinyl { position: relative; display: grid; place-items: center; flex-shrink: 0; color: var(--dance-accent); width: 130px; height: 130px; background: #090b0fa0; border-radius: 50%; border: 1px solid var(--line); }
+.dance-vinyl svg { opacity: .26; }
+.dance-vinyl > span { display: flex; flex-direction: column; align-items: center; position: absolute; font-size: 30px; line-height: 1.2; font-weight: 650; letter-spacing: -.05em; background: var(--panel); border-radius: 50%; width: 66px; height: 66px; padding-top: 10px; box-sizing: border-box; }
+.dance-vinyl small { font-size: 8px; letter-spacing: .2em; color: var(--muted); }
+.dance-vinyl.spinning svg { animation: dance-spin 8s linear infinite; }
+@keyframes dance-spin { to { transform: rotate(360deg); } }
+.dance-settings { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; padding: 22px 0; }
+.dance-settings label, .dance-meter { display: flex; flex-direction: column; gap: 7px; font-size: 11px; color: var(--muted); }
+.dance-number { display: flex; align-items: baseline; gap: 6px; }
+.dance-number input { background: transparent; border: 0; border-bottom: 1px solid var(--line); color: var(--text); font-family: inherit; font-size: 25px; width: 85px; padding: 3px 0; font-variant-numeric: tabular-nums; }
+.dance-number small { font-size: 9px; color: var(--soft); }
+.dance-meter strong { font-size: 25px; color: var(--text); font-weight: 400; }
+.dance-meter small { font-size: 9px; }
+.dance-audio { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 14px; background: #00000020; border: 1px solid var(--line); border-radius: 10px; }
+.dance-audio > div { display: flex; align-items: center; gap: 10px; margin-right: auto; min-width: 150px; flex: 1; }
+.dance-audio > div > span { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
+.dance-audio strong { font-size: 12px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px; }
+.dance-audio small { color: var(--muted); font-size: 10px; }
+.dance-audio .btn { font-size: 11px; padding: 7px 9px; }
+.dance-audio input[type=file] { display: none; }
+.dance-analysis { font-size: 10px; color: var(--soft); line-height: 1.6; margin: 9px 0 25px; }
+.dance-analysis a { color: var(--muted); text-decoration: none; white-space: nowrap; }
+.dance-soundtrack { margin-bottom: 12px; font-size: 12px; color: var(--muted); }
+.dance-soundtrack select { margin-left: 12px; background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 8px; }
+.dance-youtube { margin-bottom: 16px; }
+.dance-youtube-player { min-height: 225px; aspect-ratio: 16 / 9; background: #080808; }
+.dance-youtube-player iframe { display: block; width: 100%; height: 100%; min-height: 225px; border: 0; }
+.dance-youtube p { font-size: 11px; line-height: 1.6; color: var(--muted); }
+.dance-video-link { display: flex; gap: 8px; }
+.dance-video-link input { min-width: 0; flex: 1; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 8px; }
+.dance-timeline { position: relative; height: 55px; background: #0000002a; border-radius: 7px; overflow: hidden; }
+.dance-timeline > div { position: absolute; top: 0; height: 100%; padding: 11px 9px; box-sizing: border-box; border-right: 2px solid var(--panel); background: color-mix(in srgb, var(--dance-accent) 12%, transparent); display: flex; flex-direction: column; gap: 5px; overflow: hidden; }
+.dance-timeline > div.current { background: color-mix(in srgb, var(--dance-accent) 30%, transparent); }
+.dance-timeline strong { font-size: 11px; color: var(--dance-accent); font-weight: 550; text-transform: capitalize; white-space: nowrap; }
+.dance-timeline small { font-size: 9px; color: var(--muted); white-space: nowrap; }
+.dance-timeline > i { position: absolute; top: 0; height: 100%; width: 2px; background: white; box-shadow: 0 0 10px #fff8; }
+.dance-time-labels { display: flex; justify-content: space-between; color: var(--soft); font-size: 9px; margin-top: 7px; }
+.dance-motion-chart { display: block; width: 100%; height: 75px; margin-top: 12px; }
+.dance-axis-legend { display: flex; justify-content: center; gap: 16px; margin: 4px 0 15px; }
+.dance-axis-legend span { display: flex; align-items: center; gap: 5px; font-size: 9px; color: var(--muted); }
+.dance-axis-legend i { width: 5px; height: 5px; border-radius: 50%; }
+.dance-safe { display: flex; align-items: center; gap: 6px; font-size: 10px; color: #89cda8; }
+.dance-cue-details { font-size: 10px; color: var(--soft); line-height: 1.6; margin: 10px 0 18px; overflow-wrap: anywhere; }
+.dance-cue-details summary { cursor: pointer; }
+.dance-score-empty { display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 30px 10px; color: var(--soft); border: 1px dashed var(--line); border-radius: 10px; margin-bottom: 20px; }
+.dance-score-empty p { font-size: 12px; text-align: center; line-height: 1.7; }
+.dance-controls { display: flex; gap: 8px; margin-top: 18px; }
+.dance-controls .btn { font-size: 12px; min-height: 43px; justify-content: center; }
+.dance-controls .dance-play { margin-left: auto; background: var(--dance-accent); color: #16161c; border-color: var(--dance-accent); flex: 1; }
+.dance-footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-top: 12px; }
+.dance-footer .btn { font-size: 10px; padding-left: 0; }
+.dance-footer > span { font-size: 9px; color: var(--soft); line-height: 1.6; text-align: right; }
+.dance-bottom-note { color: var(--soft); text-align: center; font-size: 11px; line-height: 1.6; padding: 18px; }
+@media (max-width: 1080px) { .dance-layout { grid-template-columns: 260px minmax(0, 1fr); gap: 16px; } .dance-deck { padding: 20px; } .dance-vinyl { width: 96px; height: 96px; } .dance-vinyl svg { width: 86px; height: 86px; } .dance-controls { flex-wrap: wrap; } }
+@media (max-width: 820px) { .dance-layout { grid-template-columns: 1fr; } .dance-records { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; } .dance-records > .dance-section-label, .dance-library-note { grid-column: 1 / -1; } .dance-record { padding: 10px; margin-bottom: 0; } .dance-heading { align-items: flex-start; } .dance-live { font-size: 10px; } }
+@media (max-width: 520px) { .dance-records { grid-template-columns: 1fr; } .dance-view { padding: 10px 0; } .dance-heading { flex-direction: column; } .dance-settings { gap: 10px; } .dance-audio > div { flex-basis: 100%; } .dance-deck { padding: 17px; } .dance-footer { align-items: flex-start; flex-direction: column; } .dance-footer > span { text-align: left; } .dance-axis-legend { gap: 10px; } }
+@media (prefers-reduced-motion: reduce) { .dance-vinyl.spinning svg { animation: none; } }
