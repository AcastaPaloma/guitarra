+    await until(() => w.document.body.textContent.includes('synchronization missed') && !button('Prepare dance').disabled);
+    assert.equal(status.state, 'stopped'); rejectSync = false;
+    await start(); click('Stop'); await until(() => status.state === 'stopped' && !button('Prepare dance').disabled);
+    assert.equal(players.at(-1).state, 2);
+    await start(); w.unmountDance(); await until(() => status.state === 'stopped');
+    console.log('PASS: default YouTube, advancing video clock, future beat handshake, buffer/seek cancellation, autoplay blocks motors, completion, Stop and unmount. No hardware/network.');
+  } finally { w.close(); }
+})().catch(error => { console.error(error); process.exitCode = 1; });
