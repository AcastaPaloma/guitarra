@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextVideoBeat, parseYouTubeId, videoDrift } from '../src/utils/danceYouTube.ts';
+
+test('YouTube links are validated, never injected as arbitrary iframe URLs', () => {
+  for (const link of ['Sj_9CiNkkn4', 'https://youtu.be/Sj_9CiNkkn4?t=10', 'https://www.youtube.com/watch?v=Sj_9CiNkkn4&list=test', 'https://m.youtube.com/watch?v=Sj_9CiNkkn4', 'https://www.youtube-nocookie.com/embed/Sj_9CiNkkn4']) {
+    assert.equal(parseYouTubeId(link), 'Sj_9CiNkkn4');
+  }
+  for (const link of ['javascript:alert(1)', 'https://youtube.com.evil.test/watch?v=Sj_9CiNkkn4', '<iframe>', 'https://example.com/Sj_9CiNkkn4']) assert.throws(() => parseYouTubeId(link), /YouTube/);
+});
+
+test('robot joins a future video bar with network lead, including five-beat jazz', () => {
+  for (const bpm of [50, 100, 148, 174, 200]) for (const meter of [4, 5]) for (const media of [0, .15, 2, 25.123]) {
+    const first = .12, now = 123456;
+    const anchor = nextVideoBeat(media, first, bpm, meter, now);
+    const bar = 60 / bpm * meter;
+    assert.ok(anchor.start_at - now >= 1.5 - .000001);
+    assert.ok(anchor.start_at - now <= 1.5 + bar + .000001);
+    assert.ok(Math.abs((anchor.media_time - first) / bar - Math.round((anchor.media_time - first) / bar)) < 1e-8);
+    assert.ok(Math.abs(videoDrift(media + 5, anchor.media_time, now + 5, anchor.start_at)) < 1e-8);
+    assert.ok(Math.abs(videoDrift(media + 7, anchor.media_time, now + 5, anchor.start_at) - 2) < 1e-8);
+  }
+  assert.throws(() => nextVideoBeat(NaN, 0, 148, 4, 1), /Invalid/);
+  assert.throws(() => nextVideoBeat(0, 0, 300, 4, 1), /Invalid/);
+});
diff --git a/apps/dashboard/frontend/tests/dancing.test.mjs b/apps/dashboard/frontend/tests/dancing.test.mjs
new file mode 100644
index 0000000..a5b360c
--- /dev/null
+++ b/apps/dashboard/frontend/tests/dancing.test.mjs
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { analyzeBeats, DanceAudio } from '../src/utils/danceAudio.ts';
+import { ApiError, dashboardApi, pairDashboard } from '../src/api/dashboardClient.ts';
+
+test('legacy HTML 405 preserves status for the upgrade gate without exposing markup', async () => {
+  globalThis.fetch = async () => new Response('<!doctype html>\n<html lang=en><title>405 Method Not Allowed</title></html>', {
+    status: 405, statusText: 'Method Not Allowed', headers: { 'Content-Type': 'application/json' },
+  });
+  await assert.rejects(dashboardApi.getDanceCatalog(), error =>
+    error instanceof ApiError && error.status === 405 && !error.message.includes('<') && error.message.includes('/api/dances'));
+  globalThis.fetch = async () => new Response(JSON.stringify({ error: 'Meaningful backend failure' }), { status: 409 });
+  await assert.rejects(dashboardApi.getDanceCatalog(), /Meaningful backend failure/);
+});
+
+test('beat analysis estimates pulse tempo, phase, and a bounded grid locally', () => {
+  const sr = 12000, signal = new Float32Array(sr * 32), tempo = 120, phase = .2;
+  for (let t = phase; t < 32; t += 60 / tempo) {
+    const start = Math.round(t * sr);
+    for (let i = 0; i < 240 && start + i < signal.length; i++) signal[start + i] = Math.sin(i * .4) * Math.exp(-i / 50);
+  }
+  const result = analyzeBeats(signal, sr, 121);
+  assert.ok(Math.abs(result.bpm - tempo) < 1, JSON.stringify(result));
+  assert.ok(Math.abs(result.firstBeat - phase) < .04);
+  assert.equal(result.beats[0], 0);
+  assert.ok(result.beats.at(-1) > 29 && result.beats.at(-1) <= 30);
+  assert.ok(result.confidence > .4);
+});
+
+test('silent, short, and invalid-tempo audio cannot claim analyzed beats', () => {
+  assert.throws(() => analyzeBeats(new Float32Array(12000 * 30), 12000, 120), /No clear beats/);
+  assert.throws(() => analyzeBeats(new Float32Array(100), 12000, 120), /30 seconds/);
+  assert.throws(() => analyzeBeats(new Float32Array(12000 * 30), 12000, NaN), /Tempo/);
+});
+
+test('preparing and starting a dance are distinct authenticated actions', async () => {
+  const requests = [];
+  globalThis.fetch = async (path, init = {}) => {
+    requests.push({ path, init });
+    return new Response(JSON.stringify(path === '/api/auth/pair' ? { authenticated: true, csrf_token: 'test' } : {}));
+  };
+  await pairDashboard('test');
+  await dashboardApi.prepareDance('waterloo', 148, 2, [0, .4, .8]);
+  await dashboardApi.startDance('dance_test');
+  await dashboardApi.danceHeartbeat('dance_test');
+  await dashboardApi.confirmDanceAudio('dance_test', 1234.5);
+  const mutations = requests.filter(r => r.path === '/api/animations/play');
+  assert.deepEqual(mutations.map(r => JSON.parse(r.init.body).dance.operation), ['prepare', 'start', 'heartbeat', 'audio_ready']);
+  assert.ok(mutations.every(r => r.init.headers['X-LeLamp-CSRF'] === 'test'));
+  assert.deepEqual(JSON.parse(mutations[0].init.body).dance.beats, [0, .4, .8]);
+  assert.equal(JSON.parse(mutations[1].init.body).dance.audio_mode, 'laptop_beat');
+  assert.equal(JSON.parse(mutations[3].init.body).dance.start_at, 1234.5);
+});
+
+test('audio requires an unlocked context and refuses late synchronized starts', async () => {
+  const engine = new DanceAudio();
+  assert.throws(() => engine.schedule(1, [0], 4), /suspended/);
+  globalThis.AudioContext = class {
+    state = 'running';
+    async resume() {}
+    async close() {}
+  };
+  await engine.unlock();
+  assert.throws(() => engine.schedule(0, [0], 4), /Missed/);
+  assert.throws(() => engine.schedule(NaN, [0], 4), /Missed/);
+  assert.throws(() => engine.schedule(1, [0], 4, { duration: 31 }, 2), /30-second excerpt/);
+  engine.close();
+});
+
+test('song excerpt reaches the output with volume, exact offset and duration; Stop invalidates old callbacks', async () => {
+  const sources = [], gains = [], destination = {};
+  globalThis.AudioContext = class {
+    state = 'running'; currentTime = 10; destination = destination;
+    async resume() {} async close() {}
+    createGain() {
+      const gain = { gain: { value: 0 }, connect(to) { this.output = to; }, disconnect() {} };
+      gains.push(gain); return gain;
+    }
+    createBufferSource() {
+      const source = { connect(to) { this.output = to; }, disconnect() {},
+        start(...args) { this.startArgs = args; }, stop() { this.stopped = true; } };
+      sources.push(source); return source;
+    }
+  };
+  const engine = new DanceAudio(), buffer = { duration: 90 };
+  let ended = 0;
+  await engine.unlock(); engine.setVolume(.6);
+  engine.schedule(2, [0], 4, buffer, 12, () => ended++);
+  assert.equal(engine.isRunning, true);
+  assert.deepEqual(sources[0].startArgs, [12, 12, 30]);
+  assert.equal(sources[0].buffer, buffer);
+  assert.equal(sources[0].output, gains[0]);
+  assert.equal(gains[0].output, destination);
+  assert.equal(gains[0].gain.value, .6);
+  engine.setVolume(.25); assert.equal(gains[0].gain.value, .25);
+  engine.stop(); sources[0].onended();
+  assert.equal(sources[0].stopped, true);
+  assert.equal(ended, 0, 'Stop must invalidate the previous audio callback');
+  engine.schedule(2, [0], 4, buffer, 0, () => ended++);
+  sources[0].onended(); assert.equal(ended, 0);
+  sources[1].onended(); assert.equal(ended, 1);
+  assert.throws(() => engine.setVolume(NaN), /volume/);
